# The seven knockouts of the closed sourced list in scripts/colon_registration.py, against the
# published COLON phenotypes: each removes one factor and states what must disappear and what must
# remain. Three are registered PARTIAL in advance, because their published phenotype is a
# reduction or a conversion and not a deletion, and TWO are registered CONTESTED, because the
# literature disagrees about the colon: tcf7l2 and klf4 can agree with one paper only and are not
# counted as reproducing the colon. Run:
# genomeos grow data/organisms/human/colon_mutants.bio --experiments
module organism.human.colon_mutants
import colon.bio

experiment tcf7l2 { knockout: TCF7L2; until: 1 yr; expect: "the proliferating cells of the colon are abolished, so no lineage is produced (REGISTERED CONTESTED in advance: Angus-Hill et al. 2011, PNAS 108:4914 instead report adult colonic crypts lacking Tcf4 enlarged, with proliferative and differentiated cells present)"; assert: type Colonocyte at 1 yr = 0; assert: type ColonGobletCell at 1 yr = 0; assert: type ColonEnteroendocrineCell at 1 yr = 0; evidence: experimental "van Es et al. 2012, Mol Cell Biol 32:1918"; confidence: 0.8 }
experiment rbpj { knockout: RBPJ; until: 1 yr; expect: "the proliferative crypt compartment of the colon is lost completely (published as a conversion of those cells into goblet cells, which a module made of flows cannot express: registered partial in advance)"; assert: type Colonocyte at 1 yr = 0; assert: type ColonGobletCell at 1 yr = 0; assert: type ColonEnteroendocrineCell at 1 yr = 0; evidence: experimental "Pellegrinet et al. 2011, Gastroenterology 140:1230"; confidence: 0.8 }
experiment atoh1 { knockout: ATOH1; until: 1 yr; expect: "the secretory lineages are nearly absent in the colon; the absorptive colonocytes remain"; assert: type ColonGobletCell at 1 yr = 0; assert: type ColonEnteroendocrineCell at 1 yr = 0; assert: type Colonocyte at 1 yr >= 1e+06; evidence: experimental "Lo et al. 2016, Cell Mol Gastroenterol Hepatol 3:51"; confidence: 0.8 }
experiment neurog3 { knockout: NEUROG3; until: 1 yr; expect: "no enteroendocrine cells anywhere along the intestinal tract, the colon included; the colonic goblet cells remain"; assert: type ColonEnteroendocrineCell at 1 yr = 0; assert: type Colonocyte at 1 yr >= 1e+06; assert: type ColonGobletCell at 1 yr >= 1e+06; evidence: experimental "Mellitzer et al. 2010, J Clin Invest 120:1708; Jenny et al. 2002, EMBO J 21:6338"; confidence: 0.8 }
experiment gfi1 { knockout: GFI1; until: 1 yr; expect: "about a third the normal number of goblet cells, the reduction also seen in the colon, with more enteroendocrine cells (colonic PYY sixfold up); a presence-or-absence gate can only delete the goblet lineage, so the reduction is overstated: registered partial in advance"; assert: type ColonGobletCell at 1 yr = 0; assert: type Colonocyte at 1 yr >= 1e+06; assert: type ColonEnteroendocrineCell at 1 yr >= 1e+06; evidence: experimental "Shroyer et al. 2005, Genes Dev 19:2412"; confidence: 0.8 }
experiment sox9 { knockout: SOX9; until: 1 yr; expect: "a strong reduction of the colonic goblet population, the enteroendocrine and absorptive populations comparable to the control (the reduction is stated as a deletion: registered partial in advance)"; assert: type ColonGobletCell at 1 yr = 0; assert: type Colonocyte at 1 yr >= 1e+06; assert: type ColonEnteroendocrineCell at 1 yr >= 1e+06; evidence: experimental "Bastide et al. 2007, J Cell Biol 178:635"; confidence: 0.8 }
experiment klf4 { knockout: KLF4; until: 1 yr; expect: "90% fewer colonic goblet cells in the newborn, the colonocytes and enteroendocrine cells normal (REGISTERED CONTESTED in advance: Pellegrinet et al. 2011 found an adult inducible deletion changed no goblet cell number in either the small intestine or the colon, and this module has no age axis to hold both)"; assert: type ColonGobletCell at 1 yr = 0; assert: type Colonocyte at 1 yr >= 1e+06; assert: type ColonEnteroendocrineCell at 1 yr >= 1e+06; evidence: experimental "Katz et al. 2002, Development 129:2619"; confidence: 0.8 }
