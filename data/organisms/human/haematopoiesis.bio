# Generated by genomeos.organism.haematopoiesis: the blood lineages from the stem cell,
# decided by the factors the genetics showed to be necessary; flows fitted to the measured
# daily outputs and lifespans. Amplifications are inferred; requirements are cited per compartment.
module organism.human.haematopoiesis
import bio.std.development

organism Haematopoiesis {
  species: Homo sapiens
  genome: GRCh38
  root: HSC
  resolution: populations
  cell_type: HSC
  factors: CEBPA, EBF1, GATA1, GATA2, GATA3, GFI1, IKZF1, IRF8, KLF1, MYB, NOTCH1, PAX5, RUNX1, SPI1, TAL1, TCF3, TCF7
  observe: count, fates
  assert: type Erythrocyte at 3 yr in 2.16e+13..2.93e+13
  assert: type Neutrophil at 3 yr in 3.37e+11..4.55e+11
  assert: type TCell at 3 yr in 5.63e+11..8.1e+11
  evidence: curated "Sender & Milo 2021, Nat Med 27:45; Lee-Six et al. 2018; Catlin et al. 2011"; confidence: 0.5
}

stage Fill { from: 0 d; to: 90 d; evidence: inferred "every compartment fills to its adult size"; confidence: 0.3 }
stage Steady { from: 90 d; evidence: curated "adult steady state"; confidence: 0.7 }

cell_type HSC { parent: Blastomere; ontology: CL:0000037; evidence: experimental "Shivdasani et al. 1995 (TAL1); Okuda et al. 1996 (RUNX1); Tsai et al. 1994 (GATA2)"; confidence: 0.8 }
cell_type MPP { parent: HSC; ontology: CL:0000837; evidence: experimental "Busch et al. 2015 (a self-renewing progenitor tier, not HSCs, supplies the steady state); Mucenski et al. 1991 (MYB)"; confidence: 0.8 }
cell_type CMP { parent: MPP; ontology: CL:0000049; evidence: experimental "Akashi et al. 2000, Nature 404:193 (CMP)"; confidence: 0.8 }
cell_type CLP { parent: MPP; ontology: CL:0000051; evidence: experimental "Kondo et al. 1997 (CLP); Georgopoulos et al. 1994 (Ikaros: no lymphoid lineages)"; confidence: 0.8 }
cell_type MEP { parent: CMP; ontology: CL:0000050; evidence: experimental "Pevny et al. 1991; Fujiwara et al. 1996 (GATA1: no erythroid or megakaryocytic lineage)"; confidence: 0.8 }
cell_type GMP { parent: CMP; ontology: CL:0000557; evidence: experimental "Scott et al. 1994 (PU.1: no myeloid or B lineages); Zhang et al. 1997 (C/EBPa)"; confidence: 0.8 }
cell_type Erythroblast { parent: MEP; ontology: CL:0000765; evidence: experimental "Nuez et al. 1995; Perkins et al. 1995 (KLF1/EKLF: no mature erythrocytes); ~5 divisions from proerythroblast to reticulocyte"; confidence: 0.8 }
cell_type Myeloblast { parent: GMP; ontology: CL:0000835; evidence: experimental "Hock et al. 2003 (GFI1: neutropenia); ~4 divisions myeloblast to metamyelocyte"; confidence: 0.8 }
cell_type Monoblast { parent: GMP; ontology: CL:0000040; evidence: experimental "Holtschke et al. 1996 (IRF8/ICSBP: monocyte and macrophage deficiency)"; confidence: 0.8 }
cell_type ProB { parent: CLP; ontology: CL:0000826; evidence: experimental "Bain et al. 1994 (E2A); Lin & Grosschedl 1995 (EBF1); Urbanek et al. 1994 (PAX5: block at pro-B)"; confidence: 0.8 }
cell_type Thymocyte { parent: CLP; ontology: CL:0000893; evidence: experimental "Radtke et al. 1999 (Notch1: no T cells); Verbeek et al. 1995 (TCF-1); Ting et al. 1996 (GATA-3)"; confidence: 0.8 }
cell_type Erythrocyte { parent: PostMitotic; ontology: CL:0000232; evidence: curated "Cell Ontology"; confidence: 0.9 }
cell_type Neutrophil { parent: PostMitotic; ontology: CL:0000775; evidence: curated "Cell Ontology"; confidence: 0.9 }
cell_type Monocyte { parent: PostMitotic; ontology: CL:0000576; evidence: curated "Cell Ontology"; confidence: 0.9 }
cell_type BCell { parent: PostMitotic; ontology: CL:0000236; evidence: curated "Cell Ontology"; confidence: 0.9 }
cell_type TCell { parent: PostMitotic; ontology: CL:0000084; evidence: curated "Cell Ontology"; confidence: 0.9 }

# stem-cell pool: 1e+05 cells (Lee-Six 2018); output 336/day, so each HSC
# leaves the pool every 298 days and one self-renewal division
# balances the outflow
# (Catlin 2011: about one division per 280 days)
decision HSC_fill_2x { action: divide; when: cell_type = HSC, TAL1 = present, RUNX1 = present, GATA2 = present, stage = Fill, count = <5e+04; fraction: 0.190206; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision HSC_fill_10pc { action: divide; when: cell_type = HSC, TAL1 = present, RUNX1 = present, GATA2 = present, stage = Fill, count = <9e+04; fraction: 0.0249739; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision HSC_fill_1pc { action: divide; when: cell_type = HSC, TAL1 = present, RUNX1 = present, GATA2 = present, stage = Fill, count = <1e+05; fraction: 0.00333269; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision hsc_renew { action: divide; when: cell_type = HSC, TAL1 = present, RUNX1 = present, GATA2 = present, count = >=9.9e+04; fraction: 0.00083992; after: 0.25 d; evidence: inferred "self-renewal balances the outflow: one division per 298 days per HSC"; confidence: 0.3 }

decision HSC_to_MPP { action: differentiate; when: cell_type = HSC, GATA2 = present, MYB = present, RUNX1 = present, TAL1 = present; to: MPP; fraction: 0.000839215; after: 0.25 d; evidence: experimental "Busch et al. 2015 (a self-renewing progenitor tier, not HSCs, supplies the steady state); Mucenski et al. 1991 (MYB)"; confidence: 0.7 }
decision MPP_to_CMP { action: differentiate; when: cell_type = MPP, GATA2 = present, MYB = present; to: CMP; fraction: 0.0168485; after: 0.25 d; evidence: experimental "Akashi et al. 2000, Nature 404:193 (CMP)"; confidence: 0.7 }
decision MPP_to_CLP { action: differentiate; when: cell_type = MPP, GATA2 = present, IKZF1 = present, MYB = present, TCF3 = present; to: CLP; fraction: 0.0188658; after: 0.25 d; evidence: experimental "Kondo et al. 1997 (CLP); Georgopoulos et al. 1994 (Ikaros: no lymphoid lineages)"; confidence: 0.7 }
decision CMP_to_MEP { action: differentiate; when: cell_type = CMP, GATA1 = present, GATA2 = present; to: MEP; fraction: 0.0524386; after: 0.25 d; evidence: experimental "Pevny et al. 1991; Fujiwara et al. 1996 (GATA1: no erythroid or megakaryocytic lineage)"; confidence: 0.7 }
decision CMP_to_GMP { action: differentiate; when: cell_type = CMP, CEBPA = present, GATA2 = present, SPI1 = present; to: GMP; fraction: 0.0308947; after: 0.25 d; evidence: experimental "Scott et al. 1994 (PU.1: no myeloid or B lineages); Zhang et al. 1997 (C/EBPa)"; confidence: 0.7 }
decision MEP_to_Erythroblast { action: differentiate; when: cell_type = MEP, GATA1 = present, KLF1 = present; to: Erythroblast; fraction: 0.0833333; after: 0.25 d; evidence: experimental "Nuez et al. 1995; Perkins et al. 1995 (KLF1/EKLF: no mature erythrocytes); ~5 divisions from proerythroblast to reticulocyte"; confidence: 0.7 }
decision GMP_to_Myeloblast { action: differentiate; when: cell_type = GMP, CEBPA = present, GFI1 = present, SPI1 = present; to: Myeloblast; fraction: 0.0793147; after: 0.25 d; evidence: experimental "Hock et al. 2003 (GFI1: neutropenia); ~4 divisions myeloblast to metamyelocyte"; confidence: 0.7 }
decision GMP_to_Monoblast { action: differentiate; when: cell_type = GMP, CEBPA = present, IRF8 = present, SPI1 = present; to: Monoblast; fraction: 0.00401861; after: 0.25 d; evidence: experimental "Holtschke et al. 1996 (IRF8/ICSBP: monocyte and macrophage deficiency)"; confidence: 0.7 }
decision CLP_to_ProB { action: differentiate; when: cell_type = CLP, EBF1 = present, IKZF1 = present, PAX5 = present, SPI1 = present, TCF3 = present; to: ProB; fraction: 0.0756303; after: 0.25 d; evidence: experimental "Bain et al. 1994 (E2A); Lin & Grosschedl 1995 (EBF1); Urbanek et al. 1994 (PAX5: block at pro-B)"; confidence: 0.7 }
decision CLP_to_Thymocyte { action: differentiate; when: cell_type = CLP, GATA3 = present, IKZF1 = present, NOTCH1 = present, TCF3 = present, TCF7 = present; to: Thymocyte; fraction: 0.00770308; after: 0.25 d; evidence: experimental "Radtke et al. 1999 (Notch1: no T cells); Verbeek et al. 1995 (TCF-1); Ting et al. 1996 (GATA-3)"; confidence: 0.7 }

# amplification inside each compartment (inferred divisions per transit), capped at three times the
# steady pool so that a blocked outflow backs up instead of growing without bound
decision MPP_fill_2x { action: divide; when: cell_type = MPP, GATA2 = present, MYB = present, stage = Fill, count = <1.925e+07; fraction: 0.232845; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision MPP_fill_10pc { action: divide; when: cell_type = MPP, GATA2 = present, MYB = present, stage = Fill, count = <3.465e+07; fraction: 0.0616939; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision MPP_fill_1pc { action: divide; when: cell_type = MPP, GATA2 = present, MYB = present, stage = Fill, count = <3.85e+07; fraction: 0.0392774; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision MPP_amplify { action: divide; when: cell_type = MPP, GATA2 = present, MYB = present, count = <1.15e+08; fraction: 0.036693; after: 0.25 d; evidence: inferred "14 divisions per transit of 7 days; pool 3.85e+07"; confidence: 0.3 }
decision CMP_fill_2x { action: divide; when: cell_type = CMP, GATA2 = present, stage = Fill, count = <2.491e+08; fraction: 0.295028; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision CMP_fill_10pc { action: divide; when: cell_type = CMP, GATA2 = present, stage = Fill, count = <4.483e+08; fraction: 0.115244; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision CMP_fill_1pc { action: divide; when: cell_type = CMP, GATA2 = present, stage = Fill, count = <4.982e+08; fraction: 0.0916968; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision CMP_amplify { action: divide; when: cell_type = CMP, GATA2 = present, count = <1.49e+09; fraction: 0.0875665; after: 0.25 d; evidence: inferred "6 divisions per transit of 3 days; pool 4.98e+08"; confidence: 0.3 }
decision CLP_fill_2x { action: divide; when: cell_type = CLP, IKZF1 = present, TCF3 = present, stage = Fill, count = <2.789e+08; fraction: 0.296493; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision CLP_fill_10pc { action: divide; when: cell_type = CLP, IKZF1 = present, TCF3 = present, stage = Fill, count = <5.02e+08; fraction: 0.116505; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision CLP_fill_1pc { action: divide; when: cell_type = CLP, IKZF1 = present, TCF3 = present, stage = Fill, count = <5.578e+08; fraction: 0.0929316; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision CLP_amplify { action: divide; when: cell_type = CLP, IKZF1 = present, TCF3 = present, count = <1.67e+09; fraction: 0.0887967; after: 0.25 d; evidence: inferred "6 divisions per transit of 3 days; pool 5.58e+08"; confidence: 0.3 }
decision MEP_fill_2x { action: divide; when: cell_type = MEP, GATA1 = present, stage = Fill, count = <1.003e+10; fraction: 0.297317; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision MEP_fill_10pc { action: divide; when: cell_type = MEP, GATA1 = present, stage = Fill, count = <1.806e+10; fraction: 0.117215; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision MEP_fill_1pc { action: divide; when: cell_type = MEP, GATA1 = present, stage = Fill, count = <2.006e+10; fraction: 0.0936262; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision MEP_amplify { action: divide; when: cell_type = MEP, GATA1 = present, count = <6.02e+10; fraction: 0.0894886; after: 0.25 d; evidence: inferred "6 divisions per transit of 3 days; pool 2.01e+10"; confidence: 0.3 }
decision GMP_fill_2x { action: divide; when: cell_type = GMP, SPI1 = present, CEBPA = present, stage = Fill, count = <5.91e+09; fraction: 0.296866; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision GMP_fill_10pc { action: divide; when: cell_type = GMP, SPI1 = present, CEBPA = present, stage = Fill, count = <1.064e+10; fraction: 0.116827; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision GMP_fill_1pc { action: divide; when: cell_type = GMP, SPI1 = present, CEBPA = present, stage = Fill, count = <1.182e+10; fraction: 0.0932461; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision GMP_amplify { action: divide; when: cell_type = GMP, SPI1 = present, CEBPA = present, count = <3.55e+10; fraction: 0.0891099; after: 0.25 d; evidence: inferred "6 divisions per transit of 3 days; pool 1.18e+10"; confidence: 0.3 }
decision Erythroblast_fill_2x { action: divide; when: cell_type = Erythroblast, GATA1 = present, KLF1 = present, stage = Fill, count = <7.49e+11; fraction: 0.233252; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision Erythroblast_fill_10pc { action: divide; when: cell_type = Erythroblast, GATA1 = present, KLF1 = present, stage = Fill, count = <1.348e+12; fraction: 0.0620438; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision Erythroblast_fill_1pc { action: divide; when: cell_type = Erythroblast, GATA1 = present, KLF1 = present, stage = Fill, count = <1.498e+12; fraction: 0.03962; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision Erythroblast_amplify { action: divide; when: cell_type = Erythroblast, GATA1 = present, KLF1 = present, count = <4.49e+12; fraction: 0.0358796; after: 0.25 d; evidence: inferred "5 divisions per transit of 7 days; pool 1.5e+12"; confidence: 0.3 }
decision Myeloblast_fill_2x { action: divide; when: cell_type = Myeloblast, CEBPA = present, GFI1 = present, stage = Fill, count = <2.1e+11; fraction: 0.233252; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision Myeloblast_fill_10pc { action: divide; when: cell_type = Myeloblast, CEBPA = present, GFI1 = present, stage = Fill, count = <3.78e+11; fraction: 0.0620438; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision Myeloblast_fill_1pc { action: divide; when: cell_type = Myeloblast, CEBPA = present, GFI1 = present, stage = Fill, count = <4.2e+11; fraction: 0.03962; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision Myeloblast_amplify { action: divide; when: cell_type = Myeloblast, CEBPA = present, GFI1 = present, count = <1.26e+12; fraction: 0.0347222; after: 0.25 d; evidence: inferred "4 divisions per transit of 7 days; pool 4.2e+11"; confidence: 0.3 }
decision Monoblast_fill_2x { action: divide; when: cell_type = Monoblast, SPI1 = present, IRF8 = present, stage = Fill, count = <2.28e+09; fraction: 0.297317; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision Monoblast_fill_10pc { action: divide; when: cell_type = Monoblast, SPI1 = present, IRF8 = present, stage = Fill, count = <4.104e+09; fraction: 0.117215; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision Monoblast_fill_1pc { action: divide; when: cell_type = Monoblast, SPI1 = present, IRF8 = present, stage = Fill, count = <4.56e+09; fraction: 0.0936262; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision Monoblast_amplify { action: divide; when: cell_type = Monoblast, SPI1 = present, IRF8 = present, count = <1.37e+10; fraction: 0.0795455; after: 0.25 d; evidence: inferred "3 divisions per transit of 3 days; pool 4.56e+09"; confidence: 0.3 }
decision ProB_fill_2x { action: divide; when: cell_type = ProB, SPI1 = present, TCF3 = present, EBF1 = present, PAX5 = present, stage = Fill, count = <1.35e+10; fraction: 0.251797; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision ProB_fill_10pc { action: divide; when: cell_type = ProB, SPI1 = present, TCF3 = present, EBF1 = present, PAX5 = present, stage = Fill, count = <2.43e+10; fraction: 0.0780144; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision ProB_fill_1pc { action: divide; when: cell_type = ProB, SPI1 = present, TCF3 = present, EBF1 = present, PAX5 = present, stage = Fill, count = <2.7e+10; fraction: 0.0552533; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision ProB_amplify { action: divide; when: cell_type = ProB, SPI1 = present, TCF3 = present, EBF1 = present, PAX5 = present, count = <8.1e+10; fraction: 0.0509868; after: 0.25 d; evidence: inferred "5 divisions per transit of 5 days; pool 2.7e+10"; confidence: 0.3 }
decision Thymocyte_fill_2x { action: divide; when: cell_type = Thymocyte, NOTCH1 = present, TCF7 = present, GATA3 = present, stage = Fill, count = <2.31e+10; fraction: 0.203535; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision Thymocyte_fill_10pc { action: divide; when: cell_type = Thymocyte, NOTCH1 = present, TCF7 = present, GATA3 = present, stage = Fill, count = <4.158e+10; fraction: 0.0364524; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision Thymocyte_fill_1pc { action: divide; when: cell_type = Thymocyte, NOTCH1 = present, TCF7 = present, GATA3 = present, stage = Fill, count = <4.62e+10; fraction: 0.0145689; after: 0.25 d; evidence: inferred "an adult compartment starts at its steady pool"; confidence: 0.3 }
decision Thymocyte_amplify { action: divide; when: cell_type = Thymocyte, NOTCH1 = present, TCF7 = present, GATA3 = present, count = <1.39e+11; fraction: 0.0119541; after: 0.25 d; evidence: inferred "7 divisions per transit of 21 days; pool 4.62e+10"; confidence: 0.3 }

decision Erythroblast_to_Erythrocyte { action: differentiate; when: cell_type = Erythroblast; to: Erythrocyte; fraction: 0.0357143; after: 0.25 d; evidence: experimental "Sender & Milo 2021, Nat Med 27:45: 2.14e+11 Erythrocyte per day"; confidence: 0.7 }
decision Myeloblast_to_Neutrophil { action: differentiate; when: cell_type = Myeloblast; to: Neutrophil; fraction: 0.0357143; after: 0.25 d; evidence: experimental "Sender & Milo 2021, Nat Med 27:45: 6e+10 Neutrophil per day"; confidence: 0.7 }
decision Monoblast_to_Monocyte { action: differentiate; when: cell_type = Monoblast; to: Monocyte; fraction: 0.0833333; after: 0.25 d; evidence: experimental "Sender & Milo 2021, Nat Med 27:45: 1.52e+09 Monocyte per day"; confidence: 0.7 }
decision ProB_to_BCell { action: differentiate; when: cell_type = ProB; to: BCell; fraction: 0.05; after: 0.25 d; evidence: experimental "Sender & Milo 2021, Nat Med 27:45: 5.4e+09 BCell per day"; confidence: 0.7 }
decision Thymocyte_to_TCell { action: differentiate; when: cell_type = Thymocyte; to: TCell; fraction: 0.0119048; after: 0.25 d; evidence: experimental "Sender & Milo 2021, Nat Med 27:45: 2.2e+09 TCell per day"; confidence: 0.7 }

decision Erythrocyte_loss { action: die; when: cell_type = Erythrocyte; fraction: 0.00210084; after: 0.25 d; evidence: experimental "Sender & Milo 2021, Nat Med 27:45: lifespan 119 days"; confidence: 0.7 }
decision Neutrophil_loss { action: die; when: cell_type = Neutrophil; fraction: 0.0378788; after: 0.25 d; evidence: experimental "Sender & Milo 2021, Nat Med 27:45: lifespan 6.6 days"; confidence: 0.7 }
decision Monocyte_loss { action: die; when: cell_type = Monocyte; fraction: 0.0714286; after: 0.25 d; evidence: experimental "Sender & Milo 2021, Nat Med 27:45: lifespan 3.5 days"; confidence: 0.7 }
decision BCell_loss { action: die; when: cell_type = BCell; fraction: 0.00396825; after: 0.25 d; evidence: experimental "Sender & Milo 2021, Nat Med 27:45: lifespan 63 days"; confidence: 0.7 }
decision TCell_loss { action: die; when: cell_type = TCell; fraction: 0.00078125; after: 0.25 d; evidence: experimental "Sender & Milo 2021, Nat Med 27:45: lifespan 320 days"; confidence: 0.7 }
