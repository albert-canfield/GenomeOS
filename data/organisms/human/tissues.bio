decision NeuronHuman_loss { action: die; when: cell_type = NeuronHuman, stage = Childhood|Adult; fraction: 3.896e-06; after: 1 d; evidence: experimental "Sender & Milo 2021, Nat Med 27:45: 3e+05 cells/day, measured lifespan"; confidence: 0.7 }
decision NeuronHuman_childhood { action: divide; when: cell_type = NeuronHuman, stage = Childhood; fraction: 3.896e-06; after: 1 d; evidence: inferred "replacement plus 0/day growth: ~2.4e+11 at birth to 7.7e+10 by 18 years"; confidence: 0.3 }
decision NeuronHuman_replace { action: divide; when: cell_type = NeuronHuman, stage = Adult; fraction: 3.896e-06; after: 1 d; evidence: experimental "Sender & Milo 2021, Nat Med 27:45: production balances loss"; confidence: 0.7 }
decision Glia_loss { action: die; when: cell_type = Glia, stage = Childhood|Adult; fraction: 4.844e-05; after: 1 d; evidence: experimental "Sender & Milo 2021, Nat Med 27:45: 3.1e+06 cells/day, measured lifespan"; confidence: 0.7 }
