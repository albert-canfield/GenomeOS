decision NeuronHuman_loss { action: die; when: cell_type = NeuronHuman, stage = Childhood|Adult; fraction: 3.896e-06; after: 1 d; evidence: experimental "Sender & Milo 2021, Nat Med 27:45: 3e+05 cells/day, measured lifespan"; confidence: 0.7 }
