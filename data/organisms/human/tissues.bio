decision Keratinocyte_loss { action: die; when: cell_type = Keratinocyte, stage = Childhood|Adult; fraction: 0.03083; after: 1 d; evidence: experimental "Sender & Milo 2021, Nat Med 27:45: 3.7e+09 cells/day, measured lifespan"; confidence: 0.7 }
