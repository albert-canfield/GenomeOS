# Generated by `genomeos data distil --only human_cell_turnover` from Sender & Milo 2021.
# Adult counts, germ-layer shares (share of the layer's adult cell count), growth to the
# adult count and daily turnover per tissue population. Counts, not mechanism.
module organism.human.tissues
import bio.std.development

cell_type Ectoderm { parent: Blastomere; ontology: CL:0000221; evidence: curated "Cell Ontology"; confidence: 0.9 }
cell_type Mesoderm { parent: Blastomere; ontology: CL:0000222; evidence: curated "Cell Ontology"; confidence: 0.9 }
cell_type Endoderm { parent: Blastomere; ontology: CL:0000223; evidence: curated "Cell Ontology"; confidence: 0.9 }

cell_type Erythrocyte { parent: Mesoderm; ontology: CL:0000232; evidence: curated "Cell Ontology; grouped from Erythrocytes"; confidence: 0.8 }
cell_type Neutrophil { parent: Mesoderm; ontology: CL:0000775; evidence: curated "Cell Ontology; grouped from Neutrophils"; confidence: 0.8 }
cell_type Lymphocyte { parent: Mesoderm; ontology: CL:0000542; evidence: curated "Cell Ontology; grouped from Mature T cells, Mature B cells, B cells progenitors, Transitional B cells, Thymocytes"; confidence: 0.8 }
cell_type Monocyte { parent: Mesoderm; ontology: CL:0000576; evidence: curated "Cell Ontology; grouped from Monocytes, Alveolar macrophages, Kupffer cells"; confidence: 0.8 }
cell_type EndothelialCell { parent: Mesoderm; ontology: CL:0000115; evidence: curated "Cell Ontology; grouped from Endothelial cells"; confidence: 0.8 }
cell_type FibroblastDermal { parent: Mesoderm; ontology: CL:0000057; evidence: curated "Cell Ontology; grouped from Dermal fibroblasts"; confidence: 0.8 }
cell_type Adipocyte { parent: Mesoderm; ontology: CL:0000136; evidence: curated "Cell Ontology; grouped from Adipocytes"; confidence: 0.8 }
cell_type CardiomyocyteHuman { parent: Mesoderm; ontology: CL:0000746; evidence: curated "Cell Ontology; grouped from Cardiomyocytes"; confidence: 0.8 }
cell_type Myocyte { parent: Mesoderm; ontology: CL:0000187; evidence: curated "Cell Ontology; grouped from Myocytes"; confidence: 0.8 }
cell_type LungInterstitial { parent: Mesoderm; ontology: CL:0000499; evidence: curated "Cell Ontology; grouped from Lung interstitial cells"; confidence: 0.8 }
cell_type NeuronHuman { parent: Ectoderm; ontology: CL:0000540; evidence: curated "Cell Ontology; grouped from Neurons"; confidence: 0.8 }
cell_type Glia { parent: Ectoderm; ontology: CL:0000125; evidence: curated "Cell Ontology; grouped from Glial cells"; confidence: 0.8 }
cell_type Keratinocyte { parent: Ectoderm; ontology: CL:0000312; evidence: curated "Cell Ontology; grouped from Epidermal cells"; confidence: 0.8 }
cell_type Hepatocyte { parent: Endoderm; ontology: CL:0000182; evidence: curated "Cell Ontology; grouped from Hepatocytes, Stellate cells"; confidence: 0.8 }
cell_type GutEpithelium { parent: Endoderm; ontology: CL:0002563; evidence: curated "Cell Ontology; grouped from Small intestine epithelia, Colon epithelia, Stomach epithelia"; confidence: 0.8 }
cell_type LungEpithelium { parent: Endoderm; ontology: CL:0000082; evidence: curated "Cell Ontology; grouped from Alveolar epithelial cells, Bronchial epithelial cells"; confidence: 0.8 }

# Ectoderm: 2.61e+11 adult cells across 3 populations
decision ectoderm_to_Keratinocyte { action: differentiate; when: cell_type = Ectoderm, stage = Organogenesis; to: Keratinocyte; fraction: 0.4598; evidence: inferred "share of the layer's adult cell count (Sender & Milo 2021, Nat Med 27:45)"; confidence: 0.4 }
decision ectoderm_to_NeuronHuman { action: differentiate; when: cell_type = Ectoderm, stage = Organogenesis; to: NeuronHuman; fraction: 0.5461; evidence: inferred "share of the layer's adult cell count (Sender & Milo 2021, Nat Med 27:45)"; confidence: 0.4 }
decision ectoderm_to_Glia { action: differentiate; when: cell_type = Ectoderm, stage = Organogenesis; to: Glia; fraction: 1.0000; evidence: inferred "share of the layer's adult cell count (Sender & Milo 2021, Nat Med 27:45)"; confidence: 0.4 }

# Mesoderm: 2.81e+13 adult cells across 10 populations
decision mesoderm_to_Erythrocyte { action: differentiate; when: cell_type = Mesoderm, stage = Organogenesis; to: Erythrocyte; fraction: 0.9090; evidence: inferred "share of the layer's adult cell count (Sender & Milo 2021, Nat Med 27:45)"; confidence: 0.4 }
decision mesoderm_to_Lymphocyte { action: differentiate; when: cell_type = Mesoderm, stage = Organogenesis; to: Lymphocyte; fraction: 0.4076; evidence: inferred "share of the layer's adult cell count (Sender & Milo 2021, Nat Med 27:45)"; confidence: 0.4 }
decision mesoderm_to_Neutrophil { action: differentiate; when: cell_type = Mesoderm, stage = Organogenesis; to: Neutrophil; fraction: 0.4231; evidence: inferred "share of the layer's adult cell count (Sender & Milo 2021, Nat Med 27:45)"; confidence: 0.4 }
decision mesoderm_to_EndothelialCell { action: differentiate; when: cell_type = Mesoderm, stage = Organogenesis; to: EndothelialCell; fraction: 0.6876; evidence: inferred "share of the layer's adult cell count (Sender & Milo 2021, Nat Med 27:45)"; confidence: 0.4 }
decision mesoderm_to_LungInterstitial { action: differentiate; when: cell_type = Mesoderm, stage = Organogenesis; to: LungInterstitial; fraction: 0.4989; evidence: inferred "share of the layer's adult cell count (Sender & Milo 2021, Nat Med 27:45)"; confidence: 0.4 }
decision mesoderm_to_Monocyte { action: differentiate; when: cell_type = Mesoderm, stage = Organogenesis; to: Monocyte; fraction: 0.4480; evidence: inferred "share of the layer's adult cell count (Sender & Milo 2021, Nat Med 27:45)"; confidence: 0.4 }
decision mesoderm_to_FibroblastDermal { action: differentiate; when: cell_type = Mesoderm, stage = Organogenesis; to: FibroblastDermal; fraction: 0.5040; evidence: inferred "share of the layer's adult cell count (Sender & Milo 2021, Nat Med 27:45)"; confidence: 0.4 }
decision mesoderm_to_Adipocyte { action: differentiate; when: cell_type = Mesoderm, stage = Organogenesis; to: Adipocyte; fraction: 0.9091; evidence: inferred "share of the layer's adult cell count (Sender & Milo 2021, Nat Med 27:45)"; confidence: 0.4 }
decision mesoderm_to_CardiomyocyteHuman { action: differentiate; when: cell_type = Mesoderm, stage = Organogenesis; to: CardiomyocyteHuman; fraction: 0.9412; evidence: inferred "share of the layer's adult cell count (Sender & Milo 2021, Nat Med 27:45)"; confidence: 0.4 }
decision mesoderm_to_Myocyte { action: differentiate; when: cell_type = Mesoderm, stage = Organogenesis; to: Myocyte; fraction: 1.0000; evidence: inferred "share of the layer's adult cell count (Sender & Milo 2021, Nat Med 27:45)"; confidence: 0.4 }

# Endoderm: 5.61e+11 adult cells across 3 populations
decision endoderm_to_Hepatocyte { action: differentiate; when: cell_type = Endoderm, stage = Organogenesis; to: Hepatocyte; fraction: 0.4359; evidence: inferred "share of the layer's adult cell count (Sender & Milo 2021, Nat Med 27:45)"; confidence: 0.4 }
decision endoderm_to_GutEpithelium { action: differentiate; when: cell_type = Endoderm, stage = Organogenesis; to: GutEpithelium; fraction: 0.6226; evidence: inferred "share of the layer's adult cell count (Sender & Milo 2021, Nat Med 27:45)"; confidence: 0.4 }
decision endoderm_to_LungEpithelium { action: differentiate; when: cell_type = Endoderm, stage = Organogenesis; to: LungEpithelium; fraction: 1.0000; evidence: inferred "share of the layer's adult cell count (Sender & Milo 2021, Nat Med 27:45)"; confidence: 0.4 }

# growth stops at the adult count (quiescence re-evaluated at every growth step)
decision Erythrocyte_adult_count { action: quiesce; when: cell_type = Erythrocyte, count = >=2.55e+13, stage = Fetal|Childhood; evidence: curated "Sender & Milo 2021, Nat Med 27:45: 2.55e+13 cells in the reference adult"; confidence: 0.7 }
decision Neutrophil_adult_count { action: quiesce; when: cell_type = Neutrophil, count = >=6.4e+11, stage = Fetal|Childhood; evidence: curated "Sender & Milo 2021, Nat Med 27:45: 6.4e+11 cells in the reference adult"; confidence: 0.7 }
decision Lymphocyte_adult_count { action: quiesce; when: cell_type = Lymphocyte, count = >=1.04e+12, stage = Fetal|Childhood; evidence: curated "Sender & Milo 2021, Nat Med 27:45: 1.04e+12 cells in the reference adult"; confidence: 0.7 }
decision Monocyte_adult_count { action: quiesce; when: cell_type = Monocyte, count = >=6.12e+10, stage = Fetal|Childhood; evidence: curated "Sender & Milo 2021, Nat Med 27:45: 6.12e+10 cells in the reference adult"; confidence: 0.7 }
decision EndothelialCell_adult_count { action: quiesce; when: cell_type = EndothelialCell, count = >=6e+11, stage = Fetal|Childhood; evidence: curated "Sender & Milo 2021, Nat Med 27:45: 6e+11 cells in the reference adult"; confidence: 0.7 }
decision FibroblastDermal_adult_count { action: quiesce; when: cell_type = FibroblastDermal, count = >=3.8e+10, stage = Fetal|Childhood; evidence: curated "Sender & Milo 2021, Nat Med 27:45: 3.8e+10 cells in the reference adult"; confidence: 0.7 }
decision Adipocyte_adult_count { action: quiesce; when: cell_type = Adipocyte, count = >=3.4e+10, stage = Fetal|Childhood; evidence: curated "Sender & Milo 2021, Nat Med 27:45: 3.4e+10 cells in the reference adult"; confidence: 0.7 }
decision CardiomyocyteHuman_adult_count { action: quiesce; when: cell_type = CardiomyocyteHuman, count = >=3.2e+09, stage = Fetal|Childhood; evidence: curated "Sender & Milo 2021, Nat Med 27:45: 3.2e+09 cells in the reference adult"; confidence: 0.7 }
decision Myocyte_adult_count { action: quiesce; when: cell_type = Myocyte, count = >=2e+08, stage = Fetal|Childhood; evidence: curated "Sender & Milo 2021, Nat Med 27:45: 2e+08 cells in the reference adult"; confidence: 0.7 }
decision LungInterstitial_adult_count { action: quiesce; when: cell_type = LungInterstitial, count = >=1.36e+11, stage = Fetal|Childhood; evidence: curated "Sender & Milo 2021, Nat Med 27:45: 1.36e+11 cells in the reference adult"; confidence: 0.7 }
decision NeuronHuman_adult_count { action: quiesce; when: cell_type = NeuronHuman, count = >=7.7e+10, stage = Fetal|Childhood; evidence: curated "Sender & Milo 2021, Nat Med 27:45: 7.7e+10 cells in the reference adult"; confidence: 0.7 }
decision Glia_adult_count { action: quiesce; when: cell_type = Glia, count = >=6.4e+10, stage = Fetal|Childhood; evidence: curated "Sender & Milo 2021, Nat Med 27:45: 6.4e+10 cells in the reference adult"; confidence: 0.7 }
decision Keratinocyte_adult_count { action: quiesce; when: cell_type = Keratinocyte, count = >=1.2e+11, stage = Fetal|Childhood; evidence: curated "Sender & Milo 2021, Nat Med 27:45: 1.2e+11 cells in the reference adult"; confidence: 0.7 }
decision Hepatocyte_adult_count { action: quiesce; when: cell_type = Hepatocyte, count = >=2.44e+11, stage = Fetal|Childhood; evidence: curated "Sender & Milo 2021, Nat Med 27:45: 2.44e+11 cells in the reference adult"; confidence: 0.7 }
decision GutEpithelium_adult_count { action: quiesce; when: cell_type = GutEpithelium, count = >=1.97e+11, stage = Fetal|Childhood; evidence: curated "Sender & Milo 2021, Nat Med 27:45: 1.97e+11 cells in the reference adult"; confidence: 0.7 }
decision LungEpithelium_adult_count { action: quiesce; when: cell_type = LungEpithelium, count = >=1.19e+11, stage = Fetal|Childhood; evidence: curated "Sender & Milo 2021, Nat Med 27:45: 1.19e+11 cells in the reference adult"; confidence: 0.7 }

# turnover: the daily share lost, the share produced to replace it, and in childhood the
# extra growth that takes each tissue from its share of ~1.8e+12 cells at birth
# to its adult count by 18 years (inferred rates; the adult count caps the growth)
decision Erythrocyte_loss { action: die; when: cell_type = Erythrocyte, stage = Childhood|Adult; fraction: 0.008392; after: 1 d; evidence: experimental "Sender & Milo 2021, Nat Med 27:45: 2.14e+11 cells/day, measured lifespan"; confidence: 0.7 }
decision Erythrocyte_childhood { action: divide; when: cell_type = Erythrocyte, stage = Childhood; fraction: 0.009096; after: 1 d; evidence: inferred "replacement plus 0.00063/day growth: ~5.7e+11 at birth to 2.55e+13 by 18 years"; confidence: 0.3 }
decision Erythrocyte_replace { action: divide; when: cell_type = Erythrocyte, stage = Adult; fraction: 0.008463; after: 1 d; evidence: experimental "Sender & Milo 2021, Nat Med 27:45: production balances loss"; confidence: 0.7 }
decision Neutrophil_loss { action: die; when: cell_type = Neutrophil, stage = Childhood|Adult; fraction: 0.09375; after: 1 d; evidence: experimental "Sender & Milo 2021, Nat Med 27:45: 6e+10 cells/day, measured lifespan"; confidence: 0.7 }
decision Neutrophil_childhood { action: divide; when: cell_type = Neutrophil, stage = Childhood; fraction: 0.1041; after: 1 d; evidence: inferred "replacement plus 0.00063/day growth: ~1.4e+10 at birth to 6.4e+11 by 18 years"; confidence: 0.3 }
decision Neutrophil_replace { action: divide; when: cell_type = Neutrophil, stage = Adult; fraction: 0.1034; after: 1 d; evidence: experimental "Sender & Milo 2021, Nat Med 27:45: production balances loss"; confidence: 0.7 }
decision Lymphocyte_loss { action: die; when: cell_type = Lymphocyte, stage = Childhood|Adult; fraction: 0.01422; after: 1 d; evidence: inferred "Sender & Milo 2021, Nat Med 27:45: 1.48e+10 cells/day, lifespan extrapolated from rodents"; confidence: 0.4 }
decision Lymphocyte_childhood { action: divide; when: cell_type = Lymphocyte, stage = Childhood; fraction: 0.01506; after: 1 d; evidence: inferred "replacement plus 0.00063/day growth: ~2.3e+10 at birth to 1.04e+12 by 18 years"; confidence: 0.3 }
decision Lymphocyte_replace { action: divide; when: cell_type = Lymphocyte, stage = Adult; fraction: 0.01443; after: 1 d; evidence: inferred "Sender & Milo 2021, Nat Med 27:45: production balances loss"; confidence: 0.4 }
decision Monocyte_loss { action: die; when: cell_type = Monocyte, stage = Childhood|Adult; fraction: 0.02889; after: 1 d; evidence: inferred "Sender & Milo 2021, Nat Med 27:45: 1.77e+09 cells/day, lifespan extrapolated from rodents"; confidence: 0.4 }
decision Monocyte_childhood { action: divide; when: cell_type = Monocyte, stage = Childhood; fraction: 0.03038; after: 1 d; evidence: inferred "replacement plus 0.00063/day growth: ~1.4e+09 at birth to 6.12e+10 by 18 years"; confidence: 0.3 }
decision Monocyte_replace { action: divide; when: cell_type = Monocyte, stage = Adult; fraction: 0.02975; after: 1 d; evidence: inferred "Sender & Milo 2021, Nat Med 27:45: production balances loss"; confidence: 0.4 }
decision EndothelialCell_loss { action: die; when: cell_type = EndothelialCell, stage = Childhood|Adult; fraction: 0.0004; after: 1 d; evidence: experimental "Sender & Milo 2021, Nat Med 27:45: 2.4e+08 cells/day, measured lifespan"; confidence: 0.7 }
decision EndothelialCell_childhood { action: divide; when: cell_type = EndothelialCell, stage = Childhood; fraction: 0.001033; after: 1 d; evidence: inferred "replacement plus 0.00063/day growth: ~1.3e+10 at birth to 6e+11 by 18 years"; confidence: 0.3 }
decision EndothelialCell_replace { action: divide; when: cell_type = EndothelialCell, stage = Adult; fraction: 0.0004002; after: 1 d; evidence: experimental "Sender & Milo 2021, Nat Med 27:45: production balances loss"; confidence: 0.7 }
decision FibroblastDermal_loss { action: die; when: cell_type = FibroblastDermal, stage = Childhood|Adult; fraction: 0.007105; after: 1 d; evidence: inferred "Sender & Milo 2021, Nat Med 27:45: 2.7e+08 cells/day, lifespan extrapolated from rodents"; confidence: 0.4 }
decision FibroblastDermal_childhood { action: divide; when: cell_type = FibroblastDermal, stage = Childhood; fraction: 0.007789; after: 1 d; evidence: inferred "replacement plus 0.00063/day growth: ~8.5e+08 at birth to 3.8e+10 by 18 years"; confidence: 0.3 }
decision FibroblastDermal_replace { action: divide; when: cell_type = FibroblastDermal, stage = Adult; fraction: 0.007156; after: 1 d; evidence: inferred "Sender & Milo 2021, Nat Med 27:45: production balances loss"; confidence: 0.4 }
decision Adipocyte_loss { action: die; when: cell_type = Adipocyte, stage = Childhood|Adult; fraction: 0.0002353; after: 1 d; evidence: experimental "Sender & Milo 2021, Nat Med 27:45: 8e+06 cells/day, measured lifespan"; confidence: 0.7 }
decision Adipocyte_childhood { action: divide; when: cell_type = Adipocyte, stage = Childhood; fraction: 0.000868; after: 1 d; evidence: inferred "replacement plus 0.00063/day growth: ~7.6e+08 at birth to 3.4e+10 by 18 years"; confidence: 0.3 }
decision Adipocyte_replace { action: divide; when: cell_type = Adipocyte, stage = Adult; fraction: 0.0002353; after: 1 d; evidence: experimental "Sender & Milo 2021, Nat Med 27:45: production balances loss"; confidence: 0.7 }
decision CardiomyocyteHuman_loss { action: die; when: cell_type = CardiomyocyteHuman, stage = Childhood|Adult; fraction: 1.781e-05; after: 1 d; evidence: experimental "Sender & Milo 2021, Nat Med 27:45: 5.7e+04 cells/day, measured lifespan"; confidence: 0.7 }
decision CardiomyocyteHuman_childhood { action: divide; when: cell_type = CardiomyocyteHuman, stage = Childhood; fraction: 0.0006505; after: 1 d; evidence: inferred "replacement plus 0.00063/day growth: ~7.2e+07 at birth to 3.2e+09 by 18 years"; confidence: 0.3 }
decision CardiomyocyteHuman_replace { action: divide; when: cell_type = CardiomyocyteHuman, stage = Adult; fraction: 1.781e-05; after: 1 d; evidence: experimental "Sender & Milo 2021, Nat Med 27:45: production balances loss"; confidence: 0.7 }
decision Myocyte_loss { action: die; when: cell_type = Myocyte, stage = Childhood|Adult; fraction: 6.5e-05; after: 1 d; evidence: experimental "Sender & Milo 2021, Nat Med 27:45: 1.3e+04 cells/day, measured lifespan"; confidence: 0.7 }
decision Myocyte_childhood { action: divide; when: cell_type = Myocyte, stage = Childhood; fraction: 0.0006977; after: 1 d; evidence: inferred "replacement plus 0.00063/day growth: ~4.5e+06 at birth to 2e+08 by 18 years"; confidence: 0.3 }
decision Myocyte_replace { action: divide; when: cell_type = Myocyte, stage = Adult; fraction: 6.5e-05; after: 1 d; evidence: experimental "Sender & Milo 2021, Nat Med 27:45: production balances loss"; confidence: 0.7 }
decision LungInterstitial_loss { action: die; when: cell_type = LungInterstitial, stage = Childhood|Adult; fraction: 0.02279; after: 1 d; evidence: inferred "Sender & Milo 2021, Nat Med 27:45: 3.1e+09 cells/day, lifespan extrapolated from rodents"; confidence: 0.4 }
decision LungInterstitial_childhood { action: divide; when: cell_type = LungInterstitial, stage = Childhood; fraction: 0.02396; after: 1 d; evidence: inferred "replacement plus 0.00063/day growth: ~3.1e+09 at birth to 1.36e+11 by 18 years"; confidence: 0.3 }
