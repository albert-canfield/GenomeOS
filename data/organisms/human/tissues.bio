decision Hepatocyte_childhood { action: divide; when: cell_type = Hepatocyte, stage = Childhood; fraction: 0.004676; after: 1 d; evidence: inferred "replacement plus 7.4e-05/day growth: ~1.6e+11 at birth to 2.44e+11 by 18 years"; confidence: 0.3 }
