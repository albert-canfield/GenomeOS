# The five knockouts of the closed sourced list in scripts/stomach_registration.py, against the
# published STOMACH phenotypes: each removes one factor and states what must disappear and what
# must remain. Only ESRRG is registered FULL. Three are registered PARTIAL in advance, because
# their published phenotype is a maturation defect or a partial loss and not a deletion, and ONE
# is registered CONTESTED, because the one paper's genetic and pharmacological arms differ in
# severity: rbpj can agree with one of them only and is not counted as reproducing the stomach.
# neurog3 carries NO kept lineage, because its paper reports intestinal metaplasia and so does not
# report the other lineages as normal. Run:
# genomeos grow data/organisms/human/stomach_mutants.bio --experiments
module organism.human.stomach_mutants
import stomach.bio

experiment rbpj { knockout: RBPJ; until: 1 yr; expect: "pan-Notch inhibition leaves no Ki67+ cells in most corpus and antral glands, so no lineage is produced (REGISTERED CONTESTED in advance: the same paper's genetic arm, Osr1-Cre; RBP-Jk Fl/Fl, instead leaves the gastric units alive and merely 47% fewer by competition, and this module has one gate and cannot satisfy both)"; assert: type GastricPitCell at 1 yr = 0; assert: type GastricParietalCell at 1 yr = 0; assert: type GastricChiefCell at 1 yr = 0; assert: type GastricEnteroendocrineCell at 1 yr = 0; evidence: experimental "Kim & Shivdasani 2011, J Exp Med 208:677"; confidence: 0.8 }
experiment esrrg { knockout: ESRRG; until: 1 yr; expect: "whole swaths of gastric units completely lack parietal cells, from birth onward; the other lineages are untouched because Atp4bCre deletes Esrrg only in cells already committed to the parietal lineage (the paper's steady-state increase in proliferation is not expressible here)"; assert: type GastricParietalCell at 1 yr = 0; assert: type GastricPitCell at 1 yr >= 1e+06; assert: type GastricChiefCell at 1 yr >= 1e+06; assert: type GastricEnteroendocrineCell at 1 yr >= 1e+06; evidence: experimental "Adkins-Threats et al. 2024, Cell Stem Cell 31:886"; confidence: 0.8 }
experiment mist1 { knockout: MIST1; until: 1 yr; expect: "the mature chief cells of the gland base are uniformly structurally abnormal and the immature transitional cells upstream accumulate markedly, while the neck cells differentiate normally; a presence-or-absence gate can only delete the mature cell, so the phenotype is overstated: registered partial in advance"; assert: type GastricChiefCell at 1 yr = 0; assert: type GastricPitCell at 1 yr >= 1e+06; assert: type GastricParietalCell at 1 yr >= 1e+06; assert: type GastricEnteroendocrineCell at 1 yr >= 1e+06; evidence: experimental "Ramsey et al. 2007, Development 134:211"; confidence: 0.8 }
experiment neurog3 { knockout: NEUROG3; until: 1 yr; expect: "the glandular stomach's glucagon-, somatostatin- and gastrin-secreting cells are absent and the enterochromaffin cells dramatically decreased; registered partial in advance and with NO kept lineage, because the same mice show intestinal metaplasia of the gastric epithelium and the paper therefore does not report the other lineages as normal"; assert: type GastricEnteroendocrineCell at 1 yr = 0; evidence: experimental "Lee et al. 2002, Genes Dev 16:1488"; confidence: 0.8 }
experiment ascl1 { knockout: ASCL1; until: 1 yr; expect: "newborn Ascl1 nulls lose the neurogenin-3-dependent endocrine cells of the stomach with normal mucous, chief and parietal cells; registered partial in advance because the enterochromaffin-like cells are normal too and this module has no endocrine subtypes, and because the readout is a newborn one"; assert: type GastricEnteroendocrineCell at 1 yr = 0; assert: type GastricPitCell at 1 yr >= 1e+06; assert: type GastricParietalCell at 1 yr >= 1e+06; assert: type GastricChiefCell at 1 yr >= 1e+06; evidence: experimental "Hibdon et al. 2023, Am J Physiol Gastrointest Liver Physiol 325:G458"; confidence: 0.8 }
