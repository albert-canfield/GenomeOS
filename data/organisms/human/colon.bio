# Generated by genomeos.organism.colon: the colonic crypt's three mature lineages from one stem
# compartment, gated by the factors of the closed sourced list in scripts/colon_registration.py,
# which was committed before any number below was fitted. Each of its seven gates rests on a
# loss-of-function phenotype fetched FOR THE COLON; ASCL2 and SPDEF, gates of the small-intestinal
# module, are excluded here for want of one, and the colon's Paneth equivalent (Reg4+ deep crypt
# secretory cells) is excluded for want of a quantity, so there are three mature lineages and no
# Paneth compartment. Two gates, TCF7L2 and KLF4, are REGISTERED CONTESTED: the literature
# disagrees about the colon and this module can agree with one paper only.
# Measured and used as given: the colonic count, daily output and lifespan (Sender & Milo 2021),
# the 20% goblet share of colonic epithelial cells (Katz et al. 2002, mouse), about 20 Lgr5+ cells
# per colonic crypt (Sasaki et al. 2016, mouse). Inferred with no primary citation: the stem
# division interval, the transit-amplifying transit and division count, the secretory progenitor
# residence. FITTED, and the only fitted number: the surface residence,
# 2.57 d, shared by all three mature lineages and solved so the
# pools sum to the published 6e+10 cells; the published mean residence is
# 3.4 d and the two measured numbers imply
# 3.53 d on their own. The count asserts below are therefore
# the closure of that fit and not a prediction; the knockouts in colon_mutants.bio are the
# prediction,
# because no mutant number is fitted. The measured 20% goblet share returns as a share of the
# mature cells (0.2) BY CONSTRUCTION and is not a check.
module organism.human.colon
import bio.std.development

organism Colon {
  species: Homo sapiens
  genome: GRCh38
  root: ColonStem
  resolution: populations
  cell_type: ColonStem
  factors: ATOH1, GFI1, KLF4, NEUROG3, RBPJ, SOX9, TCF7L2
  observe: count, fates
  assert: count at 1 yr in 5.1e+10..6.9e+10
  assert: type Colonocyte at 1 yr in 2.96e+10..4e+10
  assert: type ColonGobletCell at 1 yr in 7.44e+09..1.01e+10
  assert: type ColonEnteroendocrineCell at 1 yr in 1.49e+08..2.01e+08
  evidence: curated "Sender & Milo 2021, Nat Med 27:45; Katz et al. 2002, Development 129:2619; Sasaki et al. 2016, Proc Natl Acad Sci USA 113:E5399"; confidence: 0.4
}

stage Fill { from: 0 d; to: 90 d; evidence: inferred "every compartment fills to its adult size"; confidence: 0.3 }
stage Steady { from: 90 d; evidence: curated "adult steady state: production balances loss"; confidence: 0.7 }

cell_type ColonStem { parent: Blastomere; ontology: CL:0009043; evidence: experimental "van Es et al. 2012, Mol Cell Biol 32:1918 (an adult inducible deletion of Tcf4 abolished the proliferating Ki67+ cells of the colon within 7 days); REGISTERED CONTESTED: Angus-Hill et al. 2011, PNAS 108:4914 report adult colonic crypts lacking Tcf4 enlarged, with proliferative and differentiated cells present"; confidence: 0.8 }
cell_type ColonTA { parent: ColonStem; ontology: CL:0009011; evidence: experimental "Pellegrinet et al. 2011, Gastroenterology 140:1230 (in the colon as in the proximal intestine, the RBP-J mutant loses the proliferative crypt compartment completely and converts it into goblet cells; the conversion is not expressible here, registered partial in advance)"; confidence: 0.8 }
cell_type ColonSecretoryProgenitor { parent: ColonTA; evidence: experimental "Lo et al. 2016, Cell Mol Gastroenterol Hepatol 3:51 (an adult inducible deletion of Atoh1 leaves the secretory lineages nearly absent in the colon, the absorptive colonocytes remaining, so the secretory branch has its own gate)"; confidence: 0.8 }
cell_type Colonocyte { parent: PostMitotic; ontology: CL:1000347; evidence: curated "Cell Ontology"; confidence: 0.9 }
cell_type ColonGobletCell { parent: PostMitotic; ontology: CL:0009039; evidence: curated "Cell Ontology"; confidence: 0.9 }
cell_type ColonEnteroendocrineCell { parent: PostMitotic; ontology: CL:0009042; evidence: curated "Cell Ontology"; confidence: 0.9 }

# the stem compartment: 5.31e+08 cells leave per day and each one leaves every
# 1 day (inferred, no colon citation fetched), so the pool is
# 5.31e+08 cells. That pool is a consequence of the flows and is claimed of nothing:
# at the measured
# 20 Lgr5+ cells per colonic crypt (Sasaki et al. 2016) it would imply
# 2.66e+07 crypts, a number this module reports and checks against nothing.
decision ColonStem_fill_2x { action: divide; when: cell_type = ColonStem, TCF7L2 = present, stage = Fill, count = <1.992e+08; fraction: 0.585609; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision ColonStem_fill_10pc { action: divide; when: cell_type = ColonStem, TCF7L2 = present, stage = Fill, count = <3.586e+08; fraction: 0.365485; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision ColonStem_fill_1pc { action: divide; when: cell_type = ColonStem, TCF7L2 = present, stage = Fill, count = <3.984e+08; fraction: 0.336654; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision colonstem_renew { action: divide; when: cell_type = ColonStem, TCF7L2 = present, count = >=3.94e+08; fraction: 0.333333; after: 0.25 d; evidence: inferred "self-renewal balances the outflow: one division per 1 day per stem cell"; confidence: 0.3 }

decision ColonStem_to_ColonTA { action: differentiate; when: cell_type = ColonStem, RBPJ = present, TCF7L2 = present; to: ColonTA; share: 0.25; after: 0.25 d; evidence: experimental "Pellegrinet et al. 2011, Gastroenterology 140:1230 (in the colon as in the proximal intestine, the RBP-J mutant loses the proliferative crypt compartment completely and converts it into goblet cells; the conversion is not expressible here, registered partial in advance)"; confidence: 0.7 }
decision ColonTA_to_ColonSecretoryProgenitor { action: differentiate; when: cell_type = ColonTA, ATOH1 = present, RBPJ = present; to: ColonSecretoryProgenitor; share: 0.070701; after: 0.25 d; evidence: experimental "Lo et al. 2016, Cell Mol Gastroenterol Hepatol 3:51 (an adult inducible deletion of Atoh1 leaves the secretory lineages nearly absent in the colon, the absorptive colonocytes remaining, so the secretory branch has its own gate)"; confidence: 0.7 }

# amplification inside the transit-amplifying compartment (5 inferred divisions over
# an inferred 2.5 d transit, a doubling every
# 0.5 d),
# capped at three times the designed pool so a blocked outflow backs up instead of growing
# without bound
decision ColonTA_fill_2x { action: divide; when: cell_type = ColonTA, RBPJ = present, stage = Fill, count = <4.05e+09; fraction: 0.819956; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision ColonTA_fill_10pc { action: divide; when: cell_type = ColonTA, RBPJ = present, stage = Fill, count = <7.291e+09; fraction: 0.567298; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision ColonTA_fill_1pc { action: divide; when: cell_type = ColonTA, RBPJ = present, stage = Fill, count = <8.101e+09; fraction: 0.534206; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision ColonTA_amplify { action: divide; when: cell_type = ColonTA, RBPJ = present, count = <2.43e+10; fraction: 0.513819; after: 0.25 d; evidence: inferred "5 divisions per transit of 2.5 days; pool 1.23e+10"; confidence: 0.3 }
decision ColonSecretoryProgenitor_fill_2x { action: divide; when: cell_type = ColonSecretoryProgenitor, ATOH1 = present, stage = Fill, count = <1.734e+09; fraction: 0.585609; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision ColonSecretoryProgenitor_fill_10pc { action: divide; when: cell_type = ColonSecretoryProgenitor, ATOH1 = present, stage = Fill, count = <3.121e+09; fraction: 0.365485; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision ColonSecretoryProgenitor_fill_1pc { action: divide; when: cell_type = ColonSecretoryProgenitor, ATOH1 = present, stage = Fill, count = <3.468e+09; fraction: 0.336654; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }

decision ColonTA_to_Colonocyte { action: differentiate; when: cell_type = ColonTA, RBPJ = present; to: Colonocyte; share: 0.275873; after: 0.25 d; evidence: inferred "share 0.796 of 1.7e+10 cells per day (Sender & Milo 2021, Nat Med 27:45): the remainder once the measured goblet share and the inferred enteroendocrine share are taken"; confidence: 0.3 }
decision ColonSecretoryProgenitor_to_ColonGobletCell { action: differentiate; when: cell_type = ColonSecretoryProgenitor, ATOH1 = present, GFI1 = present, KLF4 = present, SOX9 = present; to: ColonGobletCell; share: 0.245098; after: 0.25 d; evidence: experimental "share 0.2 of 1.7e+10 cells per day (Sender & Milo 2021, Nat Med 27:45): Katz et al. 2002, Development 129:2619: in wild-type colons 20% of epithelial cells were mature goblet cells; used as the share of daily output, which follows because all three mature residences are the one fitted number"; confidence: 0.3 }
decision ColonSecretoryProgenitor_to_ColonEnteroendocrineCell { action: differentiate; when: cell_type = ColonSecretoryProgenitor, ATOH1 = present, NEUROG3 = present; to: ColonEnteroendocrineCell; share: 0.00490196; after: 0.25 d; evidence: inferred "share 0.004 of 1.7e+10 cells per day (Sender & Milo 2021, Nat Med 27:45): inside the <1% of the epithelium bound registered by the small-intestinal module (scripts/intestine_registration.py, citing Cheng & Leblond 1974 for stomach, small intestine and colon); fitted to nothing"; confidence: 0.3 }

decision Colonocyte_loss { action: die; when: cell_type = Colonocyte; fraction: 0.0971699; after: 0.25 d; evidence: inferred "residence 2.57 d: fitted: the surface residence that makes the compartment pools sum to the published 6e+10 cells of Sender & Milo 2021, Nat Med 27:45"; confidence: 0.2 }
decision ColonGobletCell_loss { action: die; when: cell_type = ColonGobletCell; fraction: 0.0971699; after: 0.25 d; evidence: inferred "residence 2.57 d: fitted with the colonocytes: no measured colonic goblet residence was found, and the colon has no resident lineage, so the surface residence is shared and the number is fitted"; confidence: 0.2 }
decision ColonEnteroendocrineCell_loss { action: die; when: cell_type = ColonEnteroendocrineCell; fraction: 0.0971699; after: 0.25 d; evidence: inferred "residence 2.57 d: fitted with the colonocytes: no measured colonic enteroendocrine residence was found"; confidence: 0.2 }
