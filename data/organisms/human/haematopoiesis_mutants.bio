# Haematopoietic knockouts against the published (mouse) phenotypes: each removes one factor from
# the module and states what should disappear and what should remain. Run:
# genomeos grow data/organisms/human/haematopoiesis_mutants.bio --experiments
module organism.human.haematopoiesis_mutants
import haematopoiesis.bio

experiment gata1 { knockout: GATA1; until: 3 yr; expect: "no erythrocytes (and no megakaryocytes); other lineages intact"; assert: type Erythrocyte at 3 yr = 0; assert: type Neutrophil at 3 yr >= 1e9; assert: type BCell at 3 yr >= 1e9; assert: type TCell at 3 yr >= 1e9; evidence: experimental "Pevny et al. 1991, Nature 349:257; Fujiwara et al. 1996"; confidence: 0.8 }
experiment klf1 { knockout: KLF1; until: 3 yr; expect: "no mature erythrocytes (fatal anaemia); myeloid and lymphoid intact"; assert: type Erythrocyte at 3 yr = 0; assert: type Neutrophil at 3 yr >= 1e9; assert: type TCell at 3 yr >= 1e9; evidence: experimental "Nuez et al. 1995, Nature 375:316; Perkins et al. 1995"; confidence: 0.8 }
experiment spi1 { knockout: SPI1; until: 3 yr; expect: "no neutrophils, monocytes or B cells; erythrocytes and T cells present"; assert: type Neutrophil at 3 yr = 0; assert: type Monocyte at 3 yr = 0; assert: type BCell at 3 yr = 0; assert: type Erythrocyte at 3 yr >= 1e9; assert: type TCell at 3 yr >= 1e9; evidence: experimental "Scott et al. 1994, Science 265:1573"; confidence: 0.8 }
experiment cebpa { knockout: CEBPA; until: 3 yr; expect: "no neutrophils; monocytes are not lost this way (they come from GMP through IRF8)"; assert: type Neutrophil at 3 yr = 0; assert: type Erythrocyte at 3 yr >= 1e9; assert: type BCell at 3 yr >= 1e9; assert: type TCell at 3 yr >= 1e9; evidence: experimental "Zhang et al. 1997, PNAS 94:569"; confidence: 0.8 }
experiment irf8 { knockout: IRF8; until: 3 yr; expect: "monocyte and macrophage deficiency"; assert: type Monocyte at 3 yr = 0; assert: type Neutrophil at 3 yr >= 1e9; assert: type Erythrocyte at 3 yr >= 1e9; evidence: experimental "Holtschke et al. 1996, Cell 87:307"; confidence: 0.8 }
experiment pax5 { knockout: PAX5; until: 3 yr; expect: "no B cells: a block at the pro-B stage"; assert: type BCell at 3 yr = 0; assert: type TCell at 3 yr >= 1e9; assert: type Erythrocyte at 3 yr >= 1e9; assert: type Neutrophil at 3 yr >= 1e9; evidence: experimental "Urbanek et al. 1994, Cell 79:901; Nutt et al. 1999"; confidence: 0.8 }
experiment notch1 { knockout: NOTCH1; until: 3 yr; expect: "no T cells"; assert: type TCell at 3 yr = 0; assert: type BCell at 3 yr >= 1e9; assert: type Erythrocyte at 3 yr >= 1e9; assert: type Neutrophil at 3 yr >= 1e9; evidence: experimental "Radtke et al. 1999, Immunity 10:547"; confidence: 0.8 }
experiment ikzf1 { knockout: IKZF1; until: 3 yr; expect: "no B or T cells (no lymphoid lineages)"; assert: type BCell at 3 yr = 0; assert: type TCell at 3 yr = 0; assert: type Erythrocyte at 3 yr >= 1e9; assert: type Neutrophil at 3 yr >= 1e9; evidence: experimental "Georgopoulos et al. 1994, Cell 79:143"; confidence: 0.8 }
experiment tal1 { knockout: TAL1; until: 3 yr; expect: "no blood at all: no haematopoietic stem cells"; assert: type Erythrocyte at 3 yr = 0; assert: type Neutrophil at 3 yr = 0; assert: type Monocyte at 3 yr = 0; assert: type BCell at 3 yr = 0; assert: type TCell at 3 yr = 0; evidence: experimental "Shivdasani et al. 1995, Nature 373:432"; confidence: 0.8 }
