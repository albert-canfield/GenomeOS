# Generated by genomeos.organism.intestine: the small-intestinal crypt-villus lineages from one
# stem compartment, gated by the factors of the closed sourced list in
# scripts/intestine_registration.py, which was committed before any number below was fitted.
# Measured and used as given: the epithelial count and daily output (Sender & Milo 2021), the
# goblet and Paneth turnover times (Cheng 1974, mouse), the stem-cell division interval
# (Snippert et al. 2010, mouse). Inferred from sourced bounds: the lineage shares of output.
# Inferred with no primary citation: the transit-amplifying transit and division count, and the
# secretory progenitor residence. FITTED, and the only fitted number: the villus residence,
# 4.7 d, solved so the pools sum to the published
# 1.2e+11 cells; the mouse-measured absorptive turnover is about 3 d and the
# published human mean residence is 5.3 d. The count asserts below are
# therefore the closure of that fit and not a prediction; the knockouts in
# intestine_mutants.bio are the prediction, because no mutant number is fitted.
module organism.human.intestine
import bio.std.development

organism Intestine {
  species: Homo sapiens
  genome: GRCh38
  root: ISC
  resolution: populations
  cell_type: ISC
  factors: ASCL2, ATOH1, GFI1, NEUROG3, RBPJ, SOX9, SPDEF, TCF7L2
  observe: count, fates
  assert: count at 1 yr in 1.02e+11..1.38e+11
  assert: type Enterocyte at 1 yr in 8.35e+10..1.13e+11
  assert: type GobletCell at 1 yr in 2.24e+09..3.04e+09
  assert: type EnteroendocrineCell at 1 yr in 7.03e+08..9.51e+08
  assert: type PanethCell at 1 yr in 5.61e+08..7.59e+08
  evidence: curated "Sender & Milo 2021, Nat Med 27:45; Cheng 1974, Am J Anat 141:461/481/521; Snippert et al. 2010, Cell 143:134"; confidence: 0.4
}

stage Fill { from: 0 d; to: 90 d; evidence: inferred "every compartment fills to its adult size"; confidence: 0.3 }
stage Steady { from: 90 d; evidence: curated "adult steady state: production balances loss"; confidence: 0.7 }

cell_type ISC { parent: Blastomere; ontology: CL:0002250; evidence: experimental "Korinek et al. 1998, Nat Genet 19:379 (Tcf4: no proliferative compartment is maintained in the prospective crypts); van der Flier et al. 2009, Cell 136:903 (Ascl2: the Lgr5 stem cells disappear within days of an induced deletion)"; confidence: 0.8 }
cell_type TA { parent: ISC; evidence: experimental "van Es et al. 2005, Nature 435:959 (conditional removal of the Notch effector RBP-J/CSL converts the proliferative crypt cells into post-mitotic goblet cells)"; confidence: 0.8 }
cell_type SecretoryProgenitor { parent: TA; evidence: experimental "Yang et al. 2001, Science 294:2155 (Math1/Atoh1: goblet, enteroendocrine and Paneth cells are depleted and enterocytes are unaffected, so the secretory branch has its own gate)"; confidence: 0.8 }
cell_type Enterocyte { parent: PostMitotic; ontology: CL:0000584; evidence: curated "Cell Ontology"; confidence: 0.9 }
cell_type GobletCell { parent: PostMitotic; ontology: CL:0000160; evidence: curated "Cell Ontology"; confidence: 0.9 }
cell_type EnteroendocrineCell { parent: PostMitotic; ontology: CL:0000164; evidence: curated "Cell Ontology"; confidence: 0.9 }
cell_type PanethCell { parent: PostMitotic; ontology: CL:0000510; evidence: curated "Cell Ontology"; confidence: 0.9 }

# the stem compartment: 6.88e+08 cells leave per day and each one leaves every
# 1 day (Snippert et al. 2010, mouse), so the pool is 6.88e+08 cells.
# That pool is a consequence of the flows and is claimed of nothing: at the measured
# 14 Lgr5 cells per crypt it would imply 4.91e+07 crypts,
# a number this module reports and does not check against a source.
decision ISC_fill_2x { action: divide; when: cell_type = ISC, ASCL2 = present, TCF7L2 = present, stage = Fill, count = <2.578e+08; fraction: 0.585609; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision ISC_fill_10pc { action: divide; when: cell_type = ISC, ASCL2 = present, TCF7L2 = present, stage = Fill, count = <4.641e+08; fraction: 0.365485; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision ISC_fill_1pc { action: divide; when: cell_type = ISC, ASCL2 = present, TCF7L2 = present, stage = Fill, count = <5.156e+08; fraction: 0.336654; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision isc_renew { action: divide; when: cell_type = ISC, ASCL2 = present, TCF7L2 = present, count = >=5.1e+08; fraction: 0.333333; after: 0.25 d; evidence: inferred "self-renewal balances the outflow: one division per 1 day per stem cell"; confidence: 0.3 }

decision ISC_to_TA { action: differentiate; when: cell_type = ISC, ASCL2 = present, RBPJ = present, TCF7L2 = present; to: TA; share: 0.25; after: 0.25 d; evidence: experimental "van Es et al. 2005, Nature 435:959 (conditional removal of the Notch effector RBP-J/CSL converts the proliferative crypt cells into post-mitotic goblet cells)"; confidence: 0.7 }
decision TA_to_SecretoryProgenitor { action: differentiate; when: cell_type = TA, ATOH1 = present, RBPJ = present; to: SecretoryProgenitor; share: 0.0173287; after: 0.25 d; evidence: experimental "Yang et al. 2001, Science 294:2155 (Math1/Atoh1: goblet, enteroendocrine and Paneth cells are depleted and enterocytes are unaffected, so the secretory branch has its own gate)"; confidence: 0.7 }

# amplification inside the transit-amplifying compartment (5 inferred divisions over
# an inferred 2.5 d transit, a doubling every 0.5 d),
# capped at three times the designed pool so a blocked outflow backs up instead of growing
# without bound
decision TA_fill_2x { action: divide; when: cell_type = TA, RBPJ = present, stage = Fill, count = <5.242e+09; fraction: 0.819956; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision TA_fill_10pc { action: divide; when: cell_type = TA, RBPJ = present, stage = Fill, count = <9.435e+09; fraction: 0.567298; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision TA_fill_1pc { action: divide; when: cell_type = TA, RBPJ = present, stage = Fill, count = <1.048e+10; fraction: 0.534206; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision TA_amplify { action: divide; when: cell_type = TA, RBPJ = present, count = <3.14e+10; fraction: 0.513819; after: 0.25 d; evidence: inferred "5 divisions per transit of 2.5 days; pool 1.59e+10"; confidence: 0.3 }
decision SecretoryProgenitor_fill_2x { action: divide; when: cell_type = SecretoryProgenitor, ATOH1 = present, stage = Fill, count = <5.5e+08; fraction: 0.585609; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision SecretoryProgenitor_fill_10pc { action: divide; when: cell_type = SecretoryProgenitor, ATOH1 = present, stage = Fill, count = <9.9e+08; fraction: 0.365485; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision SecretoryProgenitor_fill_1pc { action: divide; when: cell_type = SecretoryProgenitor, ATOH1 = present, stage = Fill, count = <1.1e+09; fraction: 0.336654; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }

decision TA_to_Enterocyte { action: differentiate; when: cell_type = TA, RBPJ = present; to: Enterocyte; share: 0.329245; after: 0.25 d; evidence: inferred "share 0.95 of 2.2e+10 cells per day (Sender & Milo 2021, Nat Med 27:45): Cheng & Leblond 1974, Am J Anat 141:461: enterocytes are >95% of villus cells"; confidence: 0.3 }
decision SecretoryProgenitor_to_GobletCell { action: differentiate; when: cell_type = SecretoryProgenitor, ATOH1 = present, GFI1 = present, SPDEF = present; to: GobletCell; share: 0.2; after: 0.25 d; evidence: inferred "share 0.04 of 2.2e+10 cells per day (Sender & Milo 2021, Nat Med 27:45): Karam 1999, Front Biosci 4:D286 (review): about 4% of epithelial cells in the duodenum"; confidence: 0.3 }
decision SecretoryProgenitor_to_EnteroendocrineCell { action: differentiate; when: cell_type = SecretoryProgenitor, ATOH1 = present, NEUROG3 = present; to: EnteroendocrineCell; share: 0.04; after: 0.25 d; evidence: inferred "share 0.008 of 2.2e+10 cells per day (Sender & Milo 2021, Nat Med 27:45): Cheng & Leblond 1974, Am J Anat 141:461: enteroendocrine cells are <1% of the epithelium"; confidence: 0.3 }
decision SecretoryProgenitor_to_PanethCell { action: differentiate; when: cell_type = SecretoryProgenitor, ATOH1 = present, GFI1 = present, SOX9 = present, SPDEF = present; to: PanethCell; share: 0.01; after: 0.25 d; evidence: inferred "share 0.002 of 2.2e+10 cells per day (Sender & Milo 2021, Nat Med 27:45): the remainder of the output once the three shares above are taken; no measured Paneth share of output was found"; confidence: 0.3 }

decision Enterocyte_loss { action: die; when: cell_type = Enterocyte; fraction: 0.0531992; after: 0.25 d; evidence: inferred "residence 4.7 d: fitted: the villus residence that makes the compartment pools sum to the published 1.2e+11 cells of Sender & Milo 2021, Nat Med 27:45"; confidence: 0.2 }
decision GobletCell_loss { action: die; when: cell_type = GobletCell; fraction: 0.0833333; after: 0.25 d; evidence: experimental "residence 3 d: Cheng 1974, Am J Anat 141:481 (II. Mucous cells): turnover about 3 days in the mouse"; confidence: 0.6 }
decision EnteroendocrineCell_loss { action: die; when: cell_type = EnteroendocrineCell; fraction: 0.0531992; after: 0.25 d; evidence: inferred "residence 4.7 d: fitted with the enterocytes: no measured enteroendocrine residence was found, so the villus residence is used and the number is fitted, not measured"; confidence: 0.2 }
decision PanethCell_loss { action: die; when: cell_type = PanethCell; fraction: 0.0166667; after: 0.25 d; evidence: experimental "residence 15 d: Cheng 1974, Am J Anat 141:521 (IV. Paneth cells): turnover about 15 days in the mouse"; confidence: 0.6 }
