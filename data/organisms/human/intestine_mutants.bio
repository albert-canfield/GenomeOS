# The eight knockouts of the closed sourced list in scripts/intestine_registration.py, against
# the published (mouse) phenotypes: each removes one factor and states what must disappear and
# what must remain. Two are registered PARTIAL in advance, because their published phenotype is a
# re-allocation and not a deletion. Run:
# genomeos grow data/organisms/human/intestine_mutants.bio --experiments
module organism.human.intestine_mutants
import intestine.bio

experiment tcf7l2 { knockout: TCF7L2; until: 1 yr; expect: "no proliferative compartment in the prospective crypts, so no lineage is produced"; assert: type Enterocyte at 1 yr = 0; assert: type GobletCell at 1 yr = 0; assert: type PanethCell at 1 yr = 0; assert: type EnteroendocrineCell at 1 yr = 0; evidence: experimental "Korinek et al. 1998, Nat Genet 19:379"; confidence: 0.8 }
experiment ascl2 { knockout: ASCL2; until: 1 yr; expect: "the stem cells disappear within days of the deletion, so no lineage is produced"; assert: type Enterocyte at 1 yr = 0; assert: type GobletCell at 1 yr = 0; assert: type PanethCell at 1 yr = 0; assert: type EnteroendocrineCell at 1 yr = 0; evidence: experimental "van der Flier et al. 2009, Cell 136:903"; confidence: 0.8 }
experiment rbpj { knockout: RBPJ; until: 1 yr; expect: "the proliferative compartment is lost (published as a conversion of those cells into goblet cells, which a module made of flows cannot express: registered partial in advance)"; assert: type Enterocyte at 1 yr = 0; assert: type GobletCell at 1 yr = 0; assert: type PanethCell at 1 yr = 0; assert: type EnteroendocrineCell at 1 yr = 0; evidence: experimental "van Es et al. 2005, Nature 435:959"; confidence: 0.8 }
experiment atoh1 { knockout: ATOH1; until: 1 yr; expect: "goblet, enteroendocrine and Paneth cells are depleted; enterocytes are unaffected"; assert: type GobletCell at 1 yr = 0; assert: type PanethCell at 1 yr = 0; assert: type EnteroendocrineCell at 1 yr = 0; assert: type Enterocyte at 1 yr >= 1e+06; evidence: experimental "Yang et al. 2001, Science 294:2155"; confidence: 0.8 }
experiment neurog3 { knockout: NEUROG3; until: 1 yr; expect: "no intestinal endocrine cells; the other epithelial types differentiate properly"; assert: type EnteroendocrineCell at 1 yr = 0; assert: type Enterocyte at 1 yr >= 1e+06; assert: type GobletCell at 1 yr >= 1e+06; assert: type PanethCell at 1 yr >= 1e+06; evidence: experimental "Jenny et al. 2002, EMBO J 21:6338"; confidence: 0.8 }
experiment gfi1 { knockout: GFI1; until: 1 yr; expect: "no Paneth cells and fewer goblet cells, with supernumerary enteroendocrine cells (the module can only delete a lineage, so 'fewer goblet' is overstated: registered partial in advance)"; assert: type GobletCell at 1 yr = 0; assert: type PanethCell at 1 yr = 0; assert: type Enterocyte at 1 yr >= 1e+06; assert: type EnteroendocrineCell at 1 yr >= 1e+06; evidence: experimental "Shroyer et al. 2005, Genes Dev 19:2412"; confidence: 0.8 }
experiment spdef { knockout: SPDEF; until: 1 yr; expect: "mature goblet and Paneth cells are lost and immature secretory progenitors accumulate"; assert: type GobletCell at 1 yr = 0; assert: type PanethCell at 1 yr = 0; assert: type Enterocyte at 1 yr >= 1e+06; assert: type EnteroendocrineCell at 1 yr >= 1e+06; evidence: experimental "Gregorieff et al. 2009, Gastroenterology 137:1333"; confidence: 0.8 }
experiment sox9 { knockout: SOX9; until: 1 yr; expect: "Paneth cells are not formed; the other epithelial types are unaffected"; assert: type PanethCell at 1 yr = 0; assert: type Enterocyte at 1 yr >= 1e+06; assert: type GobletCell at 1 yr >= 1e+06; assert: type EnteroendocrineCell at 1 yr >= 1e+06; evidence: experimental "Mori-Akiyama et al. 2007, Gastroenterology 133:539; Bastide et al. 2007, J Cell Biol 178:635"; confidence: 0.8 }
