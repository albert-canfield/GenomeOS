# Generated by genomeos.organism.stomach: the gastric gland's four mature lineages from one
# isthmus compartment, gated by the factors of the closed sourced list in
# scripts/stomach_registration.py, which was committed before any number below was fitted. Each of
# its five gates rests on a loss-of-function phenotype fetched FOR THE STOMACH; ATOH1, the
# secretory gate of both gut modules, is excluded here for want of one, and XBP1, HNF4A, SPDEF,
# FOXQ1 and KLF4 are excluded because the stomach's best-sourced phenotypes leave the cell PRESENT
# and spoiled, which a presence-or-absence gate cannot state. One gate, RBPJ, is REGISTERED
# CONTESTED: the one paper's genetic and pharmacological arms differ in severity and this module
# can satisfy one of them.
# Measured and used as given: the stomach's count and daily output (Sender & Milo 2021); per
# gastric unit in the mouse corpus, 37 pit, 12.6 neck, 67.5 zymogenic and 26.0 parietal cells, and
# the pit (3.1 d) and parietal (54 d) residences (Karam & Leblond 1993, parts I-IV); the gastric
# endocrine half-life of about 2 months (Hibdon et al. 2023). Inferred: the mouse-to-human carry-
# over of the composition, the neck residence (the midpoint of a fetched 1-2 week range), the
# endocrine residence (the half-life converted under exponential loss), the chief residence (no
# number fetched), and the endocrine standing count. FITTED, and the only fitted number: the
# isthmus residence, 2.5 d, solved so the pools sum to the
# published 1.7e+10 cells - and held against the fetched UPPER BOUND of
# 2.6 d for the isthmal granule-free cells, fetched before the
# fit. The count assert below is therefore the closure of that fit and not a prediction; the
# knockouts in stomach_mutants.bio are the prediction, because no mutant number is fitted.
# The standing composition comes back in the measured per-unit proportions BY CONSTRUCTION and is
# not a check. The daily output is used as given and is NOT fitted: 1.3e+09 cells per
# day, of which the pit lineage carries 0.934 while standing
# at 0.221 of the epithelium.
module organism.human.stomach
import bio.std.development

organism Stomach {
  species: Homo sapiens
  genome: GRCh38
  root: GastricIsthmusStem
  resolution: populations
  cell_type: GastricIsthmusStem
  factors: ASCL1, ESRRG, MIST1, NEUROG3, RBPJ
  observe: count, fates
  assert: count at 1 yr in 1.44e+10..1.96e+10
  assert: type GastricPitCell at 1 yr in 3.2e+09..4.33e+09
  assert: type GastricParietalCell at 1 yr in 2.25e+09..3.04e+09
  assert: type GastricChiefCell at 1 yr in 5.83e+09..7.89e+09
  assert: type GastricEnteroendocrineCell at 1 yr in 8.64e+07..1.17e+08
  evidence: curated "Sender & Milo 2021, Nat Med 27:45; Karam & Leblond 1993, Anat Rec 236:259-340 (parts I-V, mouse corpus); Hibdon et al. 2023, Am J Physiol Gastrointest Liver Physiol 325:G458"; confidence: 0.4
}

stage Fill { from: 0 d; to: 90 d; evidence: inferred "every compartment fills to its adult size"; confidence: 0.3 }
stage Steady { from: 90 d; evidence: curated "adult steady state: production balances loss"; confidence: 0.7 }

cell_type GastricIsthmusStem { parent: Blastomere; ontology: CL:0002183; evidence: experimental "Kim & Shivdasani 2011, J Exp Med 208:677 (pan-Notch inhibition leaves no Ki67+ cells in most corpus and antral glands); REGISTERED CONTESTED: the same paper's genetic arm (Osr1-Cre; RBP-Jk Fl/Fl) leaves the units alive and merely 47% fewer by competition. The isthmus is also the amplifying compartment: Karam & Leblond part I give the granule-free cell the highest labelling index of the unit, 32.4%"; confidence: 0.8 }
cell_type GastricNeckCell { parent: GastricIsthmusStem; ontology: CL:0002181; evidence: experimental "Karam & Leblond 1993, Anat Rec 236:297 (part III): the mucous neck cell is the chief cell's progenitor - 'neck cells migrate inward in 1-2 weeks' and become pre-zymogenic and then zymogenic cells - and this module gives it exactly one outflow for that reason. No gate: no loss-of-function sentence removing the neck cell was fetched, and Ramsey et al. 2007 report the Mist1-null neck cells differentiating normally"; confidence: 0.8 }
cell_type GastricPitCell { parent: PostMitotic; ontology: CL:0002179; evidence: curated "Cell Ontology, looked up in EBI OLS4"; confidence: 0.9 }
cell_type GastricParietalCell { parent: PostMitotic; ontology: CL:0000162; evidence: curated "Cell Ontology, looked up in EBI OLS4"; confidence: 0.9 }
cell_type GastricChiefCell { parent: PostMitotic; ontology: CL:0000155; evidence: curated "Cell Ontology, looked up in EBI OLS4"; confidence: 0.9 }
cell_type GastricEnteroendocrineCell { parent: PostMitotic; ontology: CL:1000222; evidence: curated "Cell Ontology, looked up in EBI OLS4"; confidence: 0.9 }

# the isthmus: 1.3e+09 cells leave it per day, which is the whole daily output, and
# the ONE FITTED NUMBER is its residence, 2.499 d, solved so that every pool
# together equals the published 1.7e+10 cells. Karam & Leblond part I put the
# granule-free cell's turnover at less than 2.6 d, fetched before
# the fit, so the knob had a bound to miss. The pool it implies is
# 3.25e+09 cells, and at the measured 37 pit cells per gastric unit the module would
# imply 1.02e+08 units - a consequence of the flows, checked against nothing.
# The root carries the cap the colonic transit-amplifying compartment carried, because in the
# stomach the root IS the amplifying compartment: a blocked outflow backs it up to
# 3 times its designed pool instead of growing without bound.
decision GastricIsthmusStem_fill_2x { action: divide; when: cell_type = GastricIsthmusStem, RBPJ = present, stage = Fill, count = <1.462e+09; fraction: 0.32142; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision GastricIsthmusStem_fill_10pc { action: divide; when: cell_type = GastricIsthmusStem, RBPJ = present, stage = Fill, count = <2.631e+09; fraction: 0.137972; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision GastricIsthmusStem_fill_1pc { action: divide; when: cell_type = GastricIsthmusStem, RBPJ = present, stage = Fill, count = <2.923e+09; fraction: 0.113945; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision isthmus_renew { action: divide; when: cell_type = GastricIsthmusStem, RBPJ = present, count = <8.77e+09; fraction: 0.111178; after: 0.25 d; evidence: inferred "self-renewal balances the outflow: the isthmus residence is the one fitted number, 2.499 d"; confidence: 0.3 }

decision GastricIsthmusStem_to_GastricNeckCell { action: differentiate; when: cell_type = GastricIsthmusStem, RBPJ = present; to: GastricNeckCell; share: 0.00278051; after: 0.25 d; evidence: experimental "Karam & Leblond 1993, Anat Rec 236:297 (part III): the mucous neck cell is the chief cell's progenitor - 'neck cells migrate inward in 1-2 weeks' and become pre-zymogenic and then zymogenic cells - and this module gives it exactly one outflow for that reason. No gate: no loss-of-function sentence removing the neck cell was fetched, and Ramsey et al. 2007 report the Mist1-null neck cells differentiating normally"; confidence: 0.7 }

# the neck compartment, the chief cell's progenitor, with exactly ONE outflow: with the chief
# route gated off nothing leaves it (registered reading R4), which is not the colonic secretory
# progenitor's case, where a second outflow carried the whole inflow
decision GastricNeckCell_fill_2x { action: divide; when: cell_type = GastricNeckCell, stage = Fill, count = <1.897e+08; fraction: 0.218212; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision GastricNeckCell_fill_10pc { action: divide; when: cell_type = GastricNeckCell, stage = Fill, count = <3.414e+08; fraction: 0.0490921; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision GastricNeckCell_fill_1pc { action: divide; when: cell_type = GastricNeckCell, stage = Fill, count = <3.793e+08; fraction: 0.0269417; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }

decision GastricIsthmusStem_to_GastricPitCell { action: differentiate; when: cell_type = GastricIsthmusStem, RBPJ = present; to: GastricPitCell; share: 0.0934145; after: 0.25 d; evidence: experimental "standing count 37 per gastric unit and residence 3.1 d give this share 0.9336 of the inflow: Karam & Leblond 1993, Anat Rec 236:259-340 (parts I-V, mouse corpus) part II: 'The pit region includes an average of 37 pit cells'"; confidence: 0.3 }
decision GastricIsthmusStem_to_GastricParietalCell { action: differentiate; when: cell_type = GastricIsthmusStem, ESRRG = present, RBPJ = present; to: GastricParietalCell; share: 0.00376837; after: 0.25 d; evidence: experimental "standing count 26 per gastric unit and residence 54 d give this share 0.03766 of the inflow: Karam & Leblond 1993, Anat Rec 236:259-340 (parts I-V, mouse corpus) part IV: '3.6 cells are in the pit, 6.2 in the isthmus, 5.6 in the neck, and 10.6 in the base'"; confidence: 0.3 }
decision GastricNeckCell_to_GastricChiefCell { action: differentiate; when: cell_type = GastricNeckCell, MIST1 = present; to: GastricChiefCell; share: 0.0238095; after: 0.25 d; evidence: experimental "standing count 67.5 per gastric unit and residence 190 d give this share 1 of the inflow: Karam & Leblond 1993, Anat Rec 236:259-340 (parts I-V, mouse corpus) part III: 'Zymogenic cells, which average 67.5 per unit'"; confidence: 0.3 }
decision GastricIsthmusStem_to_GastricEnteroendocrineCell { action: differentiate; when: cell_type = GastricIsthmusStem, ASCL1 = present, NEUROG3 = present, RBPJ = present; to: GastricEnteroendocrineCell; share: 9.04167e-05; after: 0.25 d; evidence: inferred "standing count 1 per gastric unit and residence 86.56 d give this share 0.0009037 of the inflow: INFERRED: the one lineage of the four with no measured count. 1.0 cell per unit is inside the <1% of the epithelium bound carried from the small-intestinal registration (Cheng & Leblond 1974 for stomach, small intestine and colon), and is fitted to nothing"; confidence: 0.3 }

# every mature lineage is filled to its adult pool during the Fill stage, which neither gut module
# needed: a lineage that lives 190 days cannot reach its pool inside 90 days by inflow alone
decision GastricPitCell_fill_2x { action: divide; when: cell_type = GastricPitCell, stage = Fill, count = <1.881e+09; fraction: 0.189207; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision GastricPitCell_fill_10pc { action: divide; when: cell_type = GastricPitCell, stage = Fill, count = <3.386e+09; fraction: 0.0241137; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision GastricPitCell_fill_1pc { action: divide; when: cell_type = GastricPitCell, stage = Fill, count = <3.763e+09; fraction: 0.00249068; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision GastricParietalCell_fill_2x { action: divide; when: cell_type = GastricParietalCell, ESRRG = present, stage = Fill, count = <1.322e+09; fraction: 0.189207; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision GastricParietalCell_fill_10pc { action: divide; when: cell_type = GastricParietalCell, ESRRG = present, stage = Fill, count = <2.38e+09; fraction: 0.0241137; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision GastricParietalCell_fill_1pc { action: divide; when: cell_type = GastricParietalCell, ESRRG = present, stage = Fill, count = <2.644e+09; fraction: 0.00249068; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision GastricChiefCell_fill_2x { action: divide; when: cell_type = GastricChiefCell, MIST1 = present, stage = Fill, count = <3.432e+09; fraction: 0.189207; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision GastricChiefCell_fill_10pc { action: divide; when: cell_type = GastricChiefCell, MIST1 = present, stage = Fill, count = <6.178e+09; fraction: 0.0241137; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision GastricChiefCell_fill_1pc { action: divide; when: cell_type = GastricChiefCell, MIST1 = present, stage = Fill, count = <6.864e+09; fraction: 0.00249068; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision GastricEnteroendocrineCell_fill_2x { action: divide; when: cell_type = GastricEnteroendocrineCell, ASCL1 = present, NEUROG3 = present, stage = Fill, count = <5.085e+07; fraction: 0.189207; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision GastricEnteroendocrineCell_fill_10pc { action: divide; when: cell_type = GastricEnteroendocrineCell, ASCL1 = present, NEUROG3 = present, stage = Fill, count = <9.152e+07; fraction: 0.0241137; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }
decision GastricEnteroendocrineCell_fill_1pc { action: divide; when: cell_type = GastricEnteroendocrineCell, ASCL1 = present, NEUROG3 = present, stage = Fill, count = <1.017e+08; fraction: 0.00249068; after: 0.25 d; evidence: inferred "a module of the adult epithelium starts at its steady pool"; confidence: 0.3 }

decision GastricPitCell_loss { action: die; when: cell_type = GastricPitCell; fraction: 0.0806452; after: 0.25 d; evidence: inferred "residence 3.1 d: Karam & Leblond 1993, Anat Rec 236:259-340 (parts I-V, mouse corpus) part II: the migration to the gastric surface 'takes 3.1 days on the average'"; confidence: 0.2 }
decision GastricParietalCell_loss { action: die; when: cell_type = GastricParietalCell; fraction: 0.00462963; after: 0.25 d; evidence: inferred "residence 54 d: Karam & Leblond 1993, Anat Rec 236:259-340 (parts I-V, mouse corpus) part IV: 'The overall turnover time of parietal cells averages 54 days'"; confidence: 0.2 }
decision GastricChiefCell_loss { action: die; when: cell_type = GastricChiefCell; fraction: 0.00131579; after: 0.25 d; evidence: inferred "residence 190 d: INFERRED: no number for the chief cell's residence was fetched in this lane. READINGS R5 registers in advance that the fit moves by less than 1% for any value between 50 and 1000 days"; confidence: 0.2 }
decision GastricEnteroendocrineCell_loss { action: die; when: cell_type = GastricEnteroendocrineCell; fraction: 0.00288811; after: 0.25 d; evidence: inferred "residence 86.56 d: Hibdon et al. 2023, Am J Physiol Gastrointest Liver Physiol 325:G458: gastric endocrine cells have 'a half-life of approximately 2 months'; 86.6 d is the mean residence that implies under the exponential loss law this module applies, and the conversion is the inference"; confidence: 0.2 }
