# Mechanism where it is known: how the first divisions of C. elegans are decided.
# Maternal factors are loaded in the zygote (organism block) and segregate at each
# asymmetric division; a Wnt signal from P2 polarises EMS so that POP-1 stays high in
# MS and low in E; a Notch signal from P2 (APX-1) to ABp (GLP-1) makes ABp differ from ABa.
# These decisions come before the observed-lineage program and take precedence for the
# cells they name. Review: Maduro 2010, Dev Dyn 239:1315; Priess 2005, WormBook (Notch).
module organism.celegans.founders
import bio.std.development

signal Wnt_P2_EMS { mode: contact; ligand: MOM-2; receptor: MOM-5; from: cell = P2; to: cell = EMS; sets: Wnt = received; evidence: experimental "Thorpe et al. 1997, Cell 90:695; Rocheleau et al. 1997, Cell 90:707"; confidence: 0.9 }
signal Notch_P2_ABp { mode: contact; ligand: APX-1; receptor: GLP-1; from: cell = P2; to: cell = ABp; sets: Notch = received; evidence: experimental "Mello et al. 1994, Cell 77:95; Mickey et al. 1996, Development 122:1791"; confidence: 0.9 }
signal Notch_MS_ABalp { mode: contact; ligand: LAG-2; receptor: GLP-1; from: cell = MS; to: cell = ABalp|ABara; sets: Notch2 = received; evidence: experimental "Priess 2005, WormBook (second Notch interaction, pharynx from ABa)"; confidence: 0.8 }

decision div_P0  { action: divide; when: cell = P0;  daughters: AB, P1;  lineages: AB = AB, P1 = P; after: 0 min; asymmetric: PIE-1 -> P1, SKN-1 -> P1, PAL-1 -> P1, PAR-2 -> P1, PAR-3 -> AB; evidence: experimental "Sulston 1983; Kemphues et al. 1988, Cell 52:311 (PAR); Mello 1992 (PIE-1); Bowerman 1992 (SKN-1)"; confidence: 0.9 }
decision div_P1  { action: divide; when: cell = P1, PIE-1 = present;  daughters: EMS, P2; lineages: EMS = EMS, P2 = P; asymmetric: PIE-1 -> P2, PAL-1 -> P2; evidence: experimental "Sulston 1983; Mello et al. 1992, Cell 70:163 (PIE-1 to the germline side)"; confidence: 0.9 }
decision div_EMS { action: divide; when: cell = EMS, SKN-1 = present, Wnt = received; daughters: MS, E; lineages: MS = MS, E = E; asymmetric: POP-1 -> MS, END-3 -> E; evidence: experimental "Bowerman et al. 1992 (SKN-1 for EMS fates); Lin et al. 1998, Cell 92:229 (POP-1 high in MS, low in E); Maduro et al. 2005 (END-3)"; confidence: 0.9 }
decision div_P2  { action: divide; when: cell = P2;  daughters: C, P3;   lineages: C = C, P3 = P; asymmetric: PIE-1 -> P3, PAL-1 -> C; evidence: experimental "Sulston 1983; Hunter & Kenyon 1996, Cell 87:217 (PAL-1 for C and D)"; confidence: 0.9 }
decision div_P3  { action: divide; when: cell = P3;  daughters: D, P4;   lineages: D = D, P4 = P4; asymmetric: PIE-1 -> P4, PAL-1 -> D; evidence: experimental "Sulston 1983; Hunter & Kenyon 1996"; confidence: 0.9 }
decision germline { action: differentiate; when: cell = P4, PIE-1 = present; to: GermCell; evidence: experimental "Mello et al. 1996, Nature 382:710 (PIE-1 keeps the germline transcriptionally silent)"; confidence: 0.9 }
