# Stage 2 of the economy model, smallest program that exercises it (BIOLANG-v0.4-ECONOMY.md §5).
# Two genes share one ribosome pool so that a burden can exist at all: without a shared, finite
# capacity, expressing one protein cannot reduce another and the burden gate has nothing to measure.
module demo.stage2_pools

compartment Cytosol { volume: 1.0; absolute_volume: 2000 fL; translation: yes
  evidence: experimental "a HeLa-scale cell, for a demonstration"; confidence: 0.4 }

pool Ribosomes { location: Cytosol; size: 5e6; regenerates: 1e5 /h; returns_as: Ribosomes
  evidence: experimental "HeLa, BioNumbers BNID 100118 (to verify against the primary source)"
  confidence: 0.5 }
pool ATP { location: Cytosol; size: 3e9; regenerates: from Glycolysis, OXPHOS; returns_as: ADP
  evidence: experimental "Milo 2013, BioEssays 35:1050"; confidence: 0.5 }

allocation ribosome_share { pool: Ribosomes; policy: proportional
  evidence: inferred "demand-weighted sharing is the simplest claim, not a measured one"
  confidence: 0.3 }

gene BURDEN { basal: 100; location: Cytosol; cost: RNAPII 1 per transcript ; cost: ATP 2 per nucleotide
  evidence: inferred "a synthetic construct expressed hard, as Ceroni et al. 2015 does"
  confidence: 0.3 }
gene HOUSEKEEPER { basal: 10; location: Cytosol; cost: RNAPII 1 per transcript
  evidence: inferred "an unrelated gene sharing the same pools"; confidence: 0.3 }

protein BURDENp { location: Cytosol; cost: Ribosomes 1 per chain ; cost: ATP 4 per residue
  evidence: curated "4 ATP equivalents per peptide bond; bio.std.energetics"; confidence: 0.6 }
protein HOUSEKEEPERp { location: Cytosol; cost: Ribosomes 1 per chain ; cost: ATP 4 per residue
  evidence: curated "the same accounting, so the two differ only in demand"; confidence: 0.6 }
