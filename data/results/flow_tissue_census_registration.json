{
  "result": "flow_tissue_census_registration",
  "date": "2026-10-10",
  "registration": {
    "question": "Over one person's own coding SNVs, how many change consequence class or residue number between the canonical transcript and a tissue's dominant isoform, per tissue, with denominators? A census of disagreement between two predictions of the local trace; not a test and not an accuracy claim.",
    "person": "HG002: GIAB v4.2.1 benchmark calls (PASS rows inside the benchmark regions, chr1-22) imported locally (genomeos.genome.individuals.vcf_path). Its genotypes never enter the committed result: the result carries counts only, with no position, allele, genotype or protein change.",
    "genes": "every cached GTEx isoform table (data/knowledge/expression/gtex_isoforms_*.json, pinned by digest in this file's manifest) that names a GTEx gencode_id, matched to the local GENCODE v50 models by the unversioned Ensembl gene id, on chr1-22 where the person has calls and the reference sequence is local, and whose canonical transcript codes a protein. Tables without a gencode_id ('not in GTEx') and genes the models or the person's chromosomes lack are counted as exclusions. A gene with no universe variant counts in the gene tally and adds nothing to the per-tissue counts.",
    "gene_set_caveat": "the cached tables are the project's, not a sample of the genome: 96 of the 99 were fetched for the translation-disagreement genes (genes whose reference canonical transcript does not translate to the UniProt protein; data/results/translation_disagreements_isoforms.json) and the other three are APP, FUT2 and TP53. The census describes these genes only and is not extrapolated. A genome-wide census needs the GTEx v8 transcript TPM table, a download this lane was not cleared to make.",
    "variants": "the person's VCF rows inside the gene's locus with a one-base REF, one one-base ALT and a genotype carrying a non-reference allele, read on the canonical transcript and on every tissue's established dominant isoform; the gene's universe is those in the CDS of at least one of them. Indels, multi-allelic rows and rows whose genotype carries no ALT are counted as exclusions.",
    "canonical": "the transcript trace_gene follows (genomeos/flow/trace.py canonical_transcript): the Ensembl_canonical-tagged coding transcript in the local models, else the longest CDS.",
    "tissues": "every tissue named in the included tables (GTEx tissueSiteDetailId), each read for every census gene; a tissue a gene's table does not measure is UNKNOWN tissue_not_measured for it.",
    "rule": {
      "min_tpm": 1.0,
      "tie_ratio": 0.9,
      "established": "the gene has an isoform table; GTEx measured the tissue; the top transcript's median TPM in the tissue is at least min_tpm; the next transcript's is below tie_ratio times the top's; the top transcript is in the local models and codes a protein there",
      "reasons": [
        "no_isoform_data",
        "tissue_not_measured",
        "low_expression",
        "tie",
        "dominant_not_in_local_models",
        "dominant_non_coding"
      ],
      "never": "an UNKNOWN tissue is never read on the canonical transcript in its place"
    },
    "comparison": {
      "same": "same consequence class, residue number, HGVS p. and c. on both, or the tissue's dominant isoform IS the canonical transcript",
      "class_changed": "a different consequence class (e.g. missense on the canonical, intron on the tissue's isoform; synonymous on one, missense on the other)",
      "residue_changed": "the same class at a different residue number",
      "change_differs": "the same class and residue number, another amino acid or codon (counted beside the disagreement, not in it)",
      "disagree": "class_changed + residue_changed"
    },
    "outputs": "per tissue: variants (the denominator, the same for every tissue), unknown by reason, established, same_transcript, other_transcript, same, class_changed, residue_changed, change_differs, disagree, genes_established_other_transcript, genes_disagreeing; over all variant-tissue pairs the same sums (pairs = variants x tissues); the tissues ranked by disagree; per gene counts only (variants, coding_on_canonical, tissues where another isoform is established, tissues with a disagreement); the exclusions with their counts",
    "prediction": "none: a census, registered so that the gene set, the variant set, the rule and the wording are fixed before any count is seen",
    "wording": {
      "headline": "Over {variants} coding SNVs of {person} in {genes} genes with cached GTEx isoform tables, the consequence predicted on a tissue's dominant isoform differs in class or residue number from the one predicted on the canonical transcript in {disagree} of {established} variant-tissue pairs where the tissue's isoform is established ({unknown} of {pairs} pairs UNKNOWN; per tissue in per_tissue).",
      "reading": "Both consequences are predictions of the local trace on GTEx's population-median isoform, not measurements and not this person's own expression; the genes are the project's cached set, not a sample of the genome.",
      "if_no_variant": "No coding SNV of {person} falls in the census genes: the census is empty, and says nothing about disagreement."
    },
    "what_this_cannot_say": [
      "which consequence is right: both are predictions; neither is checked against protein data",
      "whether this person makes the isoform: the call is GTEx's median across donors",
      "anything about genes outside the cached tables, or about indels",
      "whether GENCODE v26's model of a transcript (GTEx's quantification) equals the v50 model traced"
    ],
    "what_is_already_known": [
      "the area C reading that the cerebellum's dominant APP isoform is APP695 while the canonical is APP770 (genomeos individual protein, ROADMAP D)",
      "data/results/translation_disagreements_isoforms.json, published earlier, names each of its 96 genes' most often dominant transcript and whether it codes in the local models (per gene, not per tissue, and with no person in it)",
      "before this registration the census code ran only on synthetic transcripts (tests) and on a synthetic person outside the registry (one SNV at every eleventh base of each census gene, the reference base read, the next base by A>G, C>T, G>A, T>C as ALT, all heterozygous) to check that it runs and which files it reads; it has not been run on HG002 or on any real person",
      "what that dry run printed, which reflects the GTEx side and the gene set, not any person: 99 tables, 86 with a gencode_id, 83 census genes traced; 11,666 synthetic coding SNVs (11,653 coding on the canonical); over 629,964 variant-tissue pairs (54 tissues), 172,339 established (122,106 on the canonical itself, 50,233 on another isoform) and 457,625 UNKNOWN (low_expression 420,547, dominant_non_coding 19,650, tie 14,617, dominant_not_in_local_models 2,811); class_changed 10,104, residue_changed 20,972, change_differs 0. A synthetic SNV every eleventh base weights genes by length, so these figures are not an expectation for a person's variants"
    ]
  },
